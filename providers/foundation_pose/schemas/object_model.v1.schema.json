{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "physical_agent.object_model.v1",
  "title": "Object CAD Model Registry Entry",
  "type": "object",
  "required": [
    "model_id",
    "mesh_path",
    "semantic_frame",
    "mesh_from_semantic",
    "scale_to_m"
  ],
  "properties": {
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "mesh_path": {
      "type": "string",
      "minLength": 1
    },
    "semantic_frame": {
      "type": "string",
      "minLength": 1
    },
    "mesh_from_semantic": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 16,
      "maxItems": 16
    },
    "scale_to_m": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "symmetry": {
      "type": "object"
    },
    "enabled": {
      "type": "boolean"
    },
    "revision": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "minLength": 1,
      "description": "Provider-local routing hint such as robot_base, robot_gripper, or generic_object."
    },
    "description": {
      "type": "string"
    },
    "default_child_frame": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "description": "Stable observed child frame used when a request does not override child_frame."
    }
  },
  "additionalProperties": true
}
