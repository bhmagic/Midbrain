{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "physical_agent.object_pose_request.v1",
  "title": "Object Pose Provider Request",
  "type": "object",
  "required": ["action"],
  "properties": {
    "action": {
      "type": "string",
      "enum": ["estimate", "track", "relocalize", "stop", "status", "list_models", "reload_models"]
    },
    "session_id": {"type": "string", "minLength": 1},
    "model_id": {"type": "string", "minLength": 1},
    "target_id": {"type": "string", "minLength": 1},
    "parent_frame": {"type": "string", "minLength": 1},
    "child_frame": {"type": "string", "minLength": 1},
    "mask_stream": {"type": "string", "minLength": 1},
    "mask_path": {"type": "string", "minLength": 1},
    "box_2d": {
      "description": "Gemini-compatible [ymin, xmin, ymax, xmax], normalized to 0-1000 unless bounding_box_coordinate_space says otherwise.",
      "type": "array",
      "prefixItems": [
        {"type": "number"},
        {"type": "number"},
        {"type": "number"},
        {"type": "number"}
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "bounding_box": {
      "type": "object",
      "required": ["box_2d"],
      "properties": {
        "box_2d": {
          "type": "array",
          "items": {"type": "number"},
          "minItems": 4,
          "maxItems": 4
        },
        "coordinate_space": {
          "type": "string",
          "enum": ["normalized_0_1000", "normalized_0_1", "pixels"]
        },
        "padding_fraction": {"type": "number", "minimum": 0, "maximum": 0.5}
      },
      "additionalProperties": false
    },
    "bounding_box_coordinate_space": {
      "type": "string",
      "enum": ["normalized_0_1000", "normalized_0_1", "pixels"]
    },
    "bounding_box_padding_fraction": {"type": "number", "minimum": 0, "maximum": 0.5},
    "related_skill_id": {"type": ["string", "null"]},
    "max_duration_s": {"type": "number", "exclusiveMinimum": 0},
    "max_update_hz": {"type": "number", "exclusiveMinimum": 0},
    "reason": {"type": "string"}
  },
  "additionalProperties": true
}
