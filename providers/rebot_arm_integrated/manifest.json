{
  "provider_type": "robot_arm.integrated_mit_cartesian_controller",
  "version": "0.9.1",
  "display_name": "Arm Integrated Free-Space Controller",
  "manager_ids": ["robot_arm.primary.integrated"],
  "ui": {
    "observation": {
      "kind": "MANAGER_HOSTED",
      "information_level": "RICH",
      "read_only": true
    },
    "developer": {
      "label": "Direct Arm Development Controls",
      "url_from_control": "/",
      "availability": "PROVIDER_RUNNING"
    }
  },
  "residency_modes": [
    "HOT",
    "WARM",
    "COLD"
  ],
  "capabilities": [
    "robot_arm.motion.free_space.preview_commit.v1",
    "robot_arm.integrated.assembly_profile_consumer",
    "robot_arm.integrated.arm_group_scoped_basic_lease",
    "robot_arm.integrated.physical_only",
    "robot.motion.arm.integrated.plan.transit_path.shadow",
    "robot.motion.arm.integrated.idle_profile.leased",
    "robot_arm.integrated.provider_local_control_audit",
    "robot_arm.integrated.manager_authority_shadow",
    "robot_arm.integrated.manager_shutdown_shadow_client",
    "robot_arm.integrated.manager_capability_catalog",
    "robot_arm.integrated.position_3dof_ik",
    "robot_arm.integrated.pose_6dof_ik",
    "robot_arm.integrated.controlled_frame_offset",
    "robot_arm.integrated.payload_gravity_model",
    "robot_arm.integrated.integrated_owned_smoothing",
    "robot_arm.integrated.free_space_one_point_two_meter_request_envelope",
    "robot_arm.integrated.leased_compliant_idle_hold",
    "robot_arm.integrated.leased_position_lock",
    "robot_arm.integrated.measured_commanded_joint_telemetry",
    "robot_arm.integrated.safe_terminate",
    "robot_arm.integrated.verified_gravity_float",
    "robot_arm.integrated.fenced_basic_lease",
    "robot_arm.integrated.midbrain_lifecycle",
    "robot_arm.integrated.motion_inhibit_consumer",
    "robot_arm.integrated.capability_readiness",
    "robot_arm.integrated.semantic_scene_consumer",
    "robot_arm.integrated.hand_angular_sphere_scene_consumer",
    "robot_arm.integrated.nonphysical_path_preview",
    "robot_arm.integrated.free_space_only_role"
  ],
  "required_capabilities": [
    "robot_arm.joint_state",
    "robot_arm.gravity_float",
    "robot_arm.control.operational_api_v2",
    "robot_arm.assembly_state",
    "robot_arm.control.joint_group.v1"
  ],
  "provider_dependencies": [
    {
      "provider_id": "robot_arm.rebot_dm",
      "required_residency": "HOT",
      "activation_order": 1,
      "reason": "The Basic Controller owns hardware access, joint feedback, gravity float, and the fenced operational lease."
    }
  ],
  "published_streams": [
    "robot_arm.integrated.status",
    "robot_arm.integrated.control_target",
    "robot_arm.integrated.control_audit"
  ],
  "consumed_streams": [
    "robot_arm.primary.integrated.scene"
  ],
  "package_layout": "providers/rebot_arm_integrated",
  "compatible_basic_controller": ">=0.1.20",
  "compatible_core": {
    "resource_provider_manager": ">=0.3.0",
    "world_state_fabric": ">=0.3.0",
    "audited_commit": "e226a09",
    "contract_set": "0.3.10-working-draft"
  },
  "free_space_execution": {
    "physical_gate": "SIGNED_PATH_SPECIFIC_AUTONOMOUS_POLICY_ASSERTION",
    "plan": "NON_PHYSICAL_IMMUTABLE_PATH_PLAN",
    "commit": "ONE_TIME_SIGNED_PATH_COMMIT",
    "terminal_release": "GRAVITY_FLOAT_OR_EXPLICIT_LEASED_IDLE_PROFILE",
    "trajectory": "INTEGRATED_OWNED_ARM_GROUP_STREAM_WITH_BASIC_SAFETY_CEILINGS",
    "maximum_translation_per_commit_m": 1.2,
    "default_execution_backend": "IMPEDANCE",
    "supported_execution_backends": ["IMPEDANCE", "POS_SPEED"]
  },
  "ik": {
    "position": "SELECTABLE_3DOF_POSITION_IK",
    "orientation": "SELECTABLE_6DOF_POSE_IK",
    "controlled_frame": "ASSEMBLY_PROFILE_CONTROLLED_FRAME",
    "rpy_matrix": "CORRECTED_STANDARD_RZ_RY_RX"
  },
  "semantic_scene_input": {
    "collision_primitives": ["SPHERE"],
    "supported_roi_scopes": [
      "GRIPPER_0P5M",
      "ARM_BASE_1P2M",
      "HAND_ANGULAR_4PI"
    ]
  },
  "limitations": [
    "Physical hardware validation is required; this release is software-tested only",
    "Controller-owned path-plan remains nonphysical; physical path-commit requires an exact unexpired preview, a signed short-lived one-time authorization assertion, its declared observation or autonomous kinematic context, and a fresh fenced Basic lease",
    "Generic relative-motion Agent execution uses only the signed autonomous path-plan/path-commit boundary; retired engage, teleop, runtime-settings, gripper, contact-baseline, and Fabric target-staging routes are not exposed",
    "General obstacle rerouting is not implemented; free-space planning evaluates the direct Cartesian path and may stop at its closest collision-free prefix",
    "Each signed free-space plan binds either the default IMPEDANCE backend or the selectable POS_SPEED backend; timing uses the selected Basic mode's advertised limits",
    "Contact work and gripper control are intentionally excluded; they belong to separately qualified controllers",
    "Runtime held-object geometry ingestion is not implemented; free-space motion while holding an object is prohibited until an attachment revision, payload, and collision geometry are bound into the preview",
    "Additional collision frame primitives are schema-supported but rejected fail-closed by this release; the current consumer evaluates only the ordered capsule polyline",
    "Self-collision is not implemented by the selected reBot collision profile",
    "Manager control-authority leases and shutdown plans remain advisory shadow interfaces during Phase 2; physical enforcement remains the fenced provider-local Basic lease and existing safe-termination helper",
    "Leased idle profiles are provider-local physical holds: COMPLIANT_HOLD accepts 2x-4x configured Kp, POSITION_LOCK uses POS_VEL, and every lease expiry or release returns to verified gravity float"
  ],
  "midbrain_conformance": {
    "runtime_compatibility": "AUDITED_AGAINST_MAIN_E226A09",
    "manager_lifecycle_endpoints": true,
    "global_motion_inhibit": true,
    "manager_authority_lease": "ADVISORY_SHADOW_OBSERVED_NOT_ENFORCED",
    "manager_shutdown": "SHADOW_PLAN_REQUESTED_WITHOUT_BLOCKING_SAFE_TERMINATION",
    "full_physical_control_contract": false
  },
  "execution_backends": {
    "IMPEDANCE": {
      "required_capability": "robot_arm.control.impedance",
      "basic_command_mode": "IMPEDANCE",
      "default": true,
      "signed_path_commit_maturity": "USABLE",
      "command_rate_hz": 50.0,
      "discoverable": true
    },
    "POS_SPEED": {
      "required_capability": "robot_arm.control.position_velocity_limited",
      "basic_command_mode": "POSITION_VELOCITY_LIMITED",
      "default": false,
      "signed_path_commit_maturity": "USABLE",
      "command_rate_hz": 50.0,
      "signed_path_commit_constraints": {
        "maximum_path_length_m": 1.2,
        "load": "NO_PAYLOAD_OR_HIGH_EXTERNAL_LOAD"
      },
      "discoverable": true
    }
  },
  "capability_discovery": {
    "manager_source": "heartbeat.details.capability_readiness",
    "provider_catalog_endpoint": "GET /v1/capabilities",
    "advertised_motion_capabilities": [
      "robot_arm.motion.free_space.preview_commit.v1",
      "robot.motion.arm.integrated.plan.transit_path.shadow"
    ]
  }
}
