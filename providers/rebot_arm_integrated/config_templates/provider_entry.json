{
  "id": "robot_arm.primary.integrated",
  "display_name": "Arm Integrated Staged Trajectory Controller",
  "command": "${PHYSICAL_AGENT_ROOT}/providers/rebot_arm_integrated/.venv/Scripts/python.exe",
  "args": [
    "${PHYSICAL_AGENT_ROOT}/providers/rebot_arm_integrated/provider.py",
    "--config",
    "${PHYSICAL_AGENT_ROOT}/providers/rebot_arm_integrated/config/controller.json",
    "--basic-url",
    "http://127.0.0.1:8791",
    "--manager-url",
