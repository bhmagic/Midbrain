{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Physical Agent Robot Arm Model",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "model_id",
    "joints",
    "links",
    "home"
  ],
  "properties": {
    "schema": {
      "const": "physical_agent.robot_arm_model"
    },
    "schema_version": {
      "const": 1
    },
    "model_id": {
      "type": "string"
    },
    "joints": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7
    },
    "links": {
      "type": "array",
      "minItems": 1
    },
    "home": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
