+#[unsafe(no_mangle)]
+pub extern "C" fn motor_handle_get_state_sample(
+    motor: *mut MotorHandle,
+    out_sample: *mut MotorStateSample,
+) -> i32 {
+    if motor.is_null() || out_sample.is_null() {
+        set_last_error("motor or out_sample is null");
+        return -1;
+    }
+    let motor = lock_motor_inner!(motor, "motor is null");
+    let out = unsafe { &mut *out_sample };
+    match &*motor {
+        MotorHandleInner::Damiao(m) => {
+            if let Some((state, generation, age)) = m.latest_state_sample() {
+                *out = MotorStateSample {
+                    state: damiao_state(state),
+                    generation,
+                    age_us: age.as_micros().min(u128::from(u64::MAX)) as u64,
+                };
+            } else {
+                *out = MotorStateSample {
+                    state: MotorState::default(),
+                    generation: 0,
+                    age_us: 0,
+                };
+            }
+        }
+        _ => {
+            set_last_error(
+                "state sample generation and age are currently supported only for Damiao motors",
+            );
+            return -1;
+        }
+    }
+    0
