{
  "providers": [
    {
      "id": "camera.femto_bolt",
      "display_name": "Orbbec Femto Bolt Full-Capability RGB-D Camera",
      "command": "${PHYSICAL_AGENT_ROOT}/providers/orbbec_femto_bolt/.venv/Scripts/python.exe",
      "args": [
        "${PHYSICAL_AGENT_ROOT}/providers/orbbec_femto_bolt/provider.py",
        "--manager-url",
        "${MANAGER_URL}",
        "--fabric-url",
        "${FABRIC_URL}",
        "--control-port",
        "7101",
        "--native-exe",
        "${PHYSICAL_AGENT_ROOT}/providers/orbbec_femto_bolt/native_host/build/Release/CameraHost.exe",
        "--mapping-name",
        "${CAMERA_MAPPING_NAME}",
        "--point-cloud-mode",
        "xyz",
        "--workspace-root",
        "${PHYSICAL_AGENT_ROOT}"
      ],
      "cwd": "${PHYSICAL_AGENT_ROOT}",
      "control_url": "http://127.0.0.1:7101",
      "auto_start": false,
      "graceful_stop_timeout_ms": 8000,
      "heartbeat_timeout_ms": 3500,
      "env": {}
    },
    {
      "id": "localization.local_vio",
      "display_name": "Local Inertial-First RGB-D VIO Provider",
      "dependencies": ["camera.femto_bolt"],
      "command": "${PHYSICAL_AGENT_ROOT}/providers/local_vio/.venv/Scripts/python.exe",
      "args": [
        "${PHYSICAL_AGENT_ROOT}/providers/local_vio/provider.py",
        "--manager-url",
        "${MANAGER_URL}",
        "--fabric-url",
        "${FABRIC_URL}",
        "--control-port",
        "7102",
        "--backend",
        "inertial_first_rgbd_eskf",
        "--gravity-gyro-limit-radps",
        "0.012",
        "--poll-interval",
        "0.005",
        "--inertial-publish-hz",
        "100",
        "--ir-sync-tolerance-us",
        "8000",
        "--ir-enabled",
        "--feature-preprocess-mode",
        "adaptive_circular_lcn"
      ],
      "cwd": "${PHYSICAL_AGENT_ROOT}",
      "control_url": "http://127.0.0.1:7102",
      "auto_start": false,
      "graceful_stop_timeout_ms": 5000,
      "heartbeat_timeout_ms": 3500,
      "env": {
        "PHYSICAL_AGENT_ROOT": "${PHYSICAL_AGENT_ROOT}"
      }
    }
  ]
}
