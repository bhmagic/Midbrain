# Core services
MANAGER_URL=http://127.0.0.1:7001
FABRIC_URL=http://127.0.0.1:7002
BASIC_CONTROLLER_URL=http://127.0.0.1:8791
BASIC_OPERATION_TIMEOUT_S=60
INTEGRATED_CONTROLLER_URL=http://127.0.0.1:8793
INTEGRATED_PREVIEW_TIMEOUT_S=5
MANAGER_BIND=127.0.0.1:7001
FABRIC_BIND=127.0.0.1:7002
FABRIC_HISTORY_PER_STREAM=256
FABRIC_TRANSFORM_HISTORY_PER_EDGE=4096
MANAGER_SHUTDOWN_EXECUTION_ENABLED=false

# Phase 4 policy switches remain independent and nonphysical by default.
PHASE4_BINDING_MODE=SHADOW
PHASE4_CONTROLLER_AUDIT_MODE=SHADOW
PHASE4_MANAGER_AUTHORITY_MODE=SHADOW
PHASE4_GENERIC_RGBD_ROUTE_MODE=SHADOW
PHASE4_PHYSICAL_EXECUTION_MODE=DISABLED
PHASE4_OPERATION_HARD_TIMEOUT_S=90
PHASE4_OPERATION_IDLE_TIMEOUT_S=30
PHASE4_VLM_ATTEMPT_TIMEOUT_S=45
PHASE4_VLM_ATTEMPTS_PER_BACKEND=2
PHASE4_VLM_RETRY_BACKOFF_S=0.25
PHASE4_SKILL_ADAPTER_TIMEOUT_S=60
PHASE4_AGENT_RUN_TIMEOUT_S=90
STATIONARY_CALIBRATION_TIMEOUT_S=600
PHASE5_SPATIAL_BINDING_MODE=SHADOW
PHASE5_SPATIAL_GENERIC_ROUTE_MODE=SHADOW
OPENAI_VLM_MODEL=gpt-5.6-terra
OPENAI_AGENT_MODEL=gpt-5.6-terra
OPENAI_AGENT_MODELS=gpt-5.6-terra,gpt-5.6-sol,gpt-5.6-luna
OPENAI_AGENT_REASONING_EFFORT=medium
AGENT_SKILL_DEFER_LOADING=true
PHASE4_ELIGIBLE_TOOLS=identify_pointed_object,analyze_visual_scene,verify_rgbd_image_alignment
OPENAI_AGENT_TOOL_CHOICE=auto
OPENAI_AGENT_MAX_TURNS=16
OPENAI_AGENT_SESSION_HISTORY_ITEMS=32
AGENT_RUN_JOURNAL_MAX_RUNS=500
AGENT_RUN_JOURNAL_MAX_EVENTS_PER_RUN=2048
AGENT_RUN_JOURNAL_RETENTION_DAYS=30

# Test Agent
UI_HOST=127.0.0.1
UI_PORT=8000
CAMERA_MAPPING_NAME=Local\FemtoBoltPipeline_CameraHost_v2
HEAD_CAMERA_PROVIDER_ID=camera.femto_bolt
HEAD_CAMERA_FRAME=femto_bolt_color_optical_frame
CAMERA_FIRST_FRAME_TIMEOUT_S=12
CAMERA_SKILL_CAPTURE_ATTEMPTS=2
CAMERA_SKILL_RETRY_BACKOFF_S=0.25
PROVIDER_HOT_READINESS_TIMEOUT_S=20
ARM_TRANSFORM_PROVIDER_ID=robot_arm.rebot_dm
ARM_BASE_FRAME=rebot_arm_base
ARM_TOOL_FRAME=rebot_arm_tool
LOCAL_VIO_PROVIDER_ID=localization.local_vio
AUTO_INITIALIZE_SPACE_COGNITION=true
SPACE_COGNITION_TIMEOUT_S=45
POINT_CLOUD_RETENTION_S=10
POINT_CLOUD_SAMPLE_STRIDE=10
POINT_CLOUD_HZ=5
POINT_CLOUD_MAX_POINTS=180000

# Optional perception and alignment
FOUNDATION_POSE_CONTROL_URL=http://127.0.0.1:7103
