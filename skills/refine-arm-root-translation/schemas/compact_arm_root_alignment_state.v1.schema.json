{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://midbrain.local/schemas/compact_arm_root_alignment_state.v1.schema.json",
  "title": "Midbrain Compact Arm-Root Alignment State v1",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "revision",
    "world_from_base",
    "identities",
    "last_update"
  ],
  "properties": {
    "schema": {"const": "midbrain.compact_arm_root_alignment_state"},
    "schema_version": {"const": 1},
    "revision": {"type": "integer", "minimum": 0},
    "world_from_base": {"$ref": "#/$defs/matrix4"},
    "identities": {"type": "object", "minProperties": 1},
    "last_update": {
      "type": ["object", "null"],
      "description": "Bounded diagnostics for only the latest update; this is not a parent-state link."
    }
  },
  "$defs": {
    "row4": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"type": "number"}
    },
    "matrix4": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/row4"}
    }
  },
  "additionalProperties": false
}
