{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://midbrain.local/schemas/effector_landmark_quality_review.v1.schema.json",
  "title": "Midbrain Effector Landmark Quality Review v1",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "landmark_id",
    "verdict",
    "reason",
    "reviewed_point_ids"
  ],
  "properties": {
    "schema": {"const": "midbrain.effector_landmark_quality_review"},
    "schema_version": {"const": 1},
    "landmark_id": {"type": "string", "pattern": "^[a-z0-9_]{3,100}$"},
    "verdict": {"enum": ["PASS", "FAIL", "UNRESOLVED"]},
    "reason": {"type": "string", "minLength": 1},
    "reviewed_point_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9_]{3,100}$"}
    }
  },
  "additionalProperties": false
}
