{
  "skill_type": "refine_arm_root_translation",
  "version": "0.2.0",
  "display_name": "Refine Arm-Root Translation",
  "ui": {
    "observation": {
      "kind": "MANAGER_HOSTED",
      "information_level": "RICH",
      "read_only": true
    }
  },
  "lifecycle": "FINITE",
  "agent_discovery": {
    "schema_version": 2,
    "discoverable": true,
    "tool_name": "refine_arm_root_translation",
    "description": "Follow Basic's active mounted-effector selection, observe its profile-defined rigid visual landmark with synchronized RGB-D and timestamp-bracketed FK, keep the active arm-root rotation unchanged, and estimate an XYZ-only translation refinement. The configured landmark may contain one to eight required points; every point must be detected and registered independently before their 3D arithmetic mean is usable. The caller may request one to five independent samples; the Skill excludes failed samples, averages accepted raw corrections, and performs at most one compact state update. The Skill creates no motion request and exposes the exact VLM evidence through Midbrain visual annotations.",
    "when_to_use": [
      "A valid world-to-arm-base alignment already exists and only its translation needs local refinement.",
      "A quick calibration update is useful between movements, or while the arm moves slowly enough to remain within the capture-time landmark-motion bound.",
      "A separately established active six-DOF alignment exists and a profile-defined gripper landmark can test a translation-only correction."
    ],
    "when_not_to_use": [
      "No trusted active rotation or profile-bound tool-to-landmark coordinate is available.",
      "The camera mounting or robot base is not rigid, or the observed effector exceeds the profile's capture-time landmark-motion limit.",
      "The requested operation needs rotational correction, physical movement, grasping, or contact."
    ],
    "side_effects": [
      "Before starting VLM work, the host verifies that the active arm provider identity, joint-state stream, and profile-selected local FK path are present and can bracket a current timestamp. A missing dependency returns a typed lifecycle recovery request without changing calibration state.",
      "Reads Basic's active assembly state and binds the selected mounted-effector identity, revision, and assembly fingerprint before reading synchronized RGB-D, bracketed FK, and active calibration state.",
      "Captures requested refinement samples sequentially from distinct RGB-D frames, then analyzes their independent VLM workflows concurrently. Each call carries a unique run/sample/phase request ID; a sample permits one exact-depth reselection only when needed and conditionally calls a quality-review VLM when its raw translation delta exceeds the configured review threshold.",
      "Returns a translation-only compare-and-swap update candidate and visual evidence; a Manager compare-and-swap conflict remains a structured non-applied result across the Skill process boundary; the Skill never commands, previews, or authorizes robot motion."
    ],
    "safety_class": "STATEFUL_NO_MOTION",
    "expected_latency": "HIGH",
    "required_permissions": [
      "camera.read",
      "world.transforms.read",
      "robot.transforms.read",
      "vlm.invoke",
      "world.transforms.publish"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "adoption_factor": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 1.0,
          "description": "Fraction of the accepted XYZ correction to adopt. Zero is observation-only and one adopts the full translation correction."
        },
        "sample_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "default": 1,
          "description": "Number of independent fresh observations to attempt before one state update. Failed samples are excluded from averaging, and the raw and adopted delta limits scale by the accepted sample count."
        },
        "landmark_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "default": null,
          "description": "Optional explicit profile-defined landmark ID. Use null or omit it to select the effector profile default. Common agent-generated default sentinels are also normalized safely when they do not name a real profile landmark. A landmark without a qualified tool-frame binding is rejected safely."
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "schema": {"type": "string"},
        "schema_version": {"type": "integer"},
        "status": {"type": "string"},
        "workflow_complete": {"type": "boolean"},
        "eligible_for_state_update": {"type": "boolean"},
        "state_update_applied": {"type": "boolean"},
        "retry_same_tool": {"type": "boolean"},
        "motion_usable": {"type": "boolean"},
        "physical_motion_authorized": {"type": "boolean"},
        "physical_motion_submitted": {"type": "boolean"},
        "rotation_change_allowed": {"type": "boolean"},
        "rotation_change_rad": {"type": "number"},
        "landmark_id": {"type": "string"},
        "source_revision": {"type": "integer"},
        "identities": {"type": "object"},
        "source_world_from_base": {"type": "array", "items": {"type": "array", "items": {"type": "number"}}},
        "base_from_tool": {"type": "array", "items": {"type": "array", "items": {"type": "number"}}},
        "tool_landmark_point_m": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
        "controlled_frame_to_landmark_translation_m": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
        "landmark_to_controlled_frame_translation_m": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
        "observed_world_landmark_point_m": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
        "estimated_world_controlled_frame_origin_m": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
        "expected_base_landmark_point_m": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
        "estimated_full_translation_m": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
        "raw_translation_delta_m": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
        "raw_translation_delta_norm_m": {"type": "number"},
        "adoption_factor": {"type": "number"},
        "adopted_translation_delta_m": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
        "adopted_translation_delta_norm_m": {"type": "number"},
        "proposed_world_from_base": {"type": "array", "items": {"type": "array", "items": {"type": "number"}}},
        "quality_review": {"type": "object"},
        "observation_provenance": {"type": "object"},
        "state_model": {"type": "object"},
        "resolved_landmark": {"type": "object"},
        "quality_review_evidence": {"type": "object"},
        "capture_motion": {"type": "object"},
        "vlm_invocations": {"type": "array", "items": {"type": "object"}},
        "alignment_image_back_projection": {"type": "object"},
        "refinement_limits": {"type": "object"},
        "active_revision": {"type": "integer"},
        "aggregate_candidate_only": {"type": "boolean"},
        "context_revalidation": {"type": "object"},
        "multi_sample_refinement": {"type": "object"},
        "landmark_depth_reselection": {"type": "object"},
        "visual_evidence": {"type": ["object", "array", "null"]},
        "sample_visual_evidence": {"type": "array"},
        "sample_quality_review_evidence": {"type": "array"},
        "sample_capture_motion": {"type": "array"},
        "sample_landmark_depth_reselection": {"type": "array"},
        "visual_evidence_represents": {"type": "string"},
        "selected_effector": {"type": ["object", "null"]},
        "required_capability": {"type": "string"},
        "dependency": {"type": "object"},
        "required_next_tool": {"type": ["object", "null"]},
        "retry_after_prerequisite": {"type": "object"},
        "reason": {"type": "string"},
        "message": {"type": "string"}
      },
      "required": [
        "schema", "schema_version", "status", "workflow_complete",
        "eligible_for_state_update", "multi_sample_refinement",
        "landmark_depth_reselection", "physical_motion_submitted",
        "physical_motion_authorized"
      ],
      "additionalProperties": true
    },
    "execution_adapter": {
      "adapter_id": "skill.refine_arm_root_translation.v1",
      "kind": "EXTERNAL_SKILL_ENTRYPOINT",
      "entrypoint": "python/refine_arm_root_translation/rpc_entrypoint.py",
      "host_adapter": {
        "entrypoint": "python/refine_arm_root_translation/host_adapter.py",
        "factory": "create_host_adapter"
      },
      "invocation_requires_approval": false
    }
  },
  "required_capabilities": [
    "camera.rgb",
    "camera.depth_aligned_to_rgb",
    "camera.rgbd_geometry",
    "world.transforms.timestamped",
    "world.tracking.identity",
    "robot_arm.transforms.local",
    "robot_arm.model_identity",
    "robot_arm.assembly_state",
    "perception.vision_language"
  ],
  "optional_capabilities": [
    "camera.rgbd.route.generic_shared_memory",
    "camera.rgbd.route.direct_shared_memory",
    "perception.object_pose"
  ],
  "route_policy": {
    "required_route_count": 1,
    "preference_order": [
      "camera.rgbd.route.generic_shared_memory",
      "camera.rgbd.route.direct_shared_memory"
    ],
    "selection_time": "EXECUTION",
    "explicit_provider_fallback_allowed": true
  },
  "result_policy": {
    "physical_motion_submitted": false,
    "physical_motion_authorized": false,
    "rotation_change_allowed": false,
    "translation_axes": [
      "x",
      "y",
      "z"
    ],
    "caller_selected_adoption_factor": true,
    "multi_sample_refinement": {
      "default_sample_count": 1,
      "maximum_sample_count": 5,
      "aggregation": "ARITHMETIC_MEAN_OF_RAW_TRANSLATION_DELTAS",
      "aggregation_population": "ACCEPTED_SAMPLES_ONLY",
      "all_samples_excluded_policy": "REJECT_WITHOUT_STATE_UPDATE",
      "state_updates_per_invocation": 1,
      "threshold_scale": "ACCEPTED_SAMPLE_COUNT",
      "capture_execution": "SEQUENTIAL_DISTINCT_RGBD_FRAMES",
      "analysis_execution": "CONCURRENT_PER_SAMPLE"
    },
    "effector_profile_pins_kinematic_attachment": true,
    "compact_active_state": true,
    "recursive_parent_chain": false,
    "manager_owned_bounded_rollback_journal": true,
    "activation_requires_atomic_revision_match": true,
    "visual_evidence_contract": "midbrain.visual_evidence.v1"
  },
  "installation": {
    "setup_entrypoint": "scripts/setup.ps1"
  },
  "published_streams": [],
  "environment": {
    "type": "python_venv",
    "path": ".venv",
    "python": ">=3.11",
    "shared_environment_group": "arm_root_alignment"
  }
