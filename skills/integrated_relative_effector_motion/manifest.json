        "controller_preview_refreshed": {"type": "boolean"},
        "motion_intent": {"type": "string"},
        "direction": {"type": "string"},
        "reference_frame": {"type": "string"},
        "resolved_direction_arm_base": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
        "spatial_resolution": {"type": "object"},
        "distance_m": {"type": "number"},
        "original_request_distance_m": {"type": "number"},
        "requested_speed_m_s": {"type": ["number", "null"]},
        "execution_backend": {"type": "string"},
        "requested_duration_s": {"type": ["number", "null"]},
        "planned_duration_s": {"type": "number"},
        "planned_nominal_speed_m_s": {"type": "number"},
        "timing_safety_limited": {"type": "boolean"},
        "requested_peak_joint_speed_rad_s": {"type": "number"},
        "effective_peak_joint_speed_rad_s": {"type": "number"},
        "joint_speed_authentication_required": {"type": "boolean"},
        "start_position_m": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
        "target_position_m": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
        "orientation_policy": {"type": "string"},
        "orientation_reference_frame": {"type": ["string", "null"]},
        "controlled_frame_yaw_delta_deg": {"type": ["number", "null"]},
        "controlled_frame_rpy_delta_deg": {"type": ["array", "null"], "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
        "translation_vector_m": {"type": ["array", "null"], "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
        "target_orientation_rpy_rad": {"type": ["array", "null"], "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
        "approval_required": {"type": "boolean"},
        "next_tool": {"type": "string"},
        "required_capability": {"type": "string"},
        "required_provider_id": {"type": "string"},
        "required_provider": {"type": "object"},
        "manager_resolved_dependencies": {"type": "array", "items": {"type": "object"}},
        "required_next_tool": {"type": ["object", "null"]},
        "retry_same_tool": {"type": "boolean"},
        "question": {"type": "string"},
        "required_value_on_yes": {"type": "string"},
        "required_value_on_no": {"type": "string"},
        "next_step_on_no": {"type": "string"},
        "requested_direction": {"type": "string"},
        "requested_reference_frame": {"type": "string"},
        "vio_status": {"type": "object"},
        "controller": {"type": "object"},
        "connection_detail": {"type": "string"},
        "integrated_preview": {"type": "object"},
        "visual_verification": {"type": ["object", "null"]},
        "controller_duration_s": {"type": "number"},
        "timing": {"type": "object"},
        "final_state": {"type": "string"},
        "goal_reached": {"type": "boolean"},
        "closest_safe": {"type": "boolean"},
        "closest_safe_report": {"type": ["object", "null"]},
        "authorization": {"type": "object"},
