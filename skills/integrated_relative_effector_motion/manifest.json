        "completion": {"type": "object"},
        "visual_motion_confirmed": {"type": "boolean"},
        "visual_translation_confirmed": {"type": "boolean"},
        "visual_orientation_confirmed": {"type": ["boolean", "null"]},
        "new_continuation_submitted": {"type": "boolean"},
        "message": {"type": "string"}
      },
      "required": ["status", "workflow_complete"],
      "additionalProperties": true
    },
    "execution_adapter": {
      "adapter_id": "skill.integrated_relative_effector_motion.perform.v1",
      "kind": "IN_PROCESS_BOUND_INSTANCE",
      "invocation_requires_approval": false
    }
  },
  "required_capabilities": [
    "robot_arm.joint_state",
    "robot_arm.gravity_float",
    "robot_arm.control.operational_api_v2",
    "robot_arm.motion.free_space.preview_commit.v1",
    "robot_arm.integrated.position_3dof_ik",
    "robot_arm.integrated.pose_6dof_ik"
  ],
  "optional_capabilities": [
    "localization.vio.local_pose",
    "world.transforms.timestamped",
    "robot_arm.integrated.semantic_scene_consumer"
  ],
  "route_policy": {
    "spatial_convention_id": "MIDBRAIN_X_FORWARD_Y_LEFT_Z_UP_V2",
    "camera_optical_convention_id": "CAMERA_OPTICAL_X_RIGHT_Y_DOWN_Z_FORWARD_V1",
    "anonymous_xyz_allowed": false,
    "ordinary_language_may_select_optical_axis": false,
    "provider_activation_sequence": [
      {
        "provider_id": "robot_arm.rebot_dm",
        "required_residency": "HOT",
        "reason": "Owns the hardware, joint feedback, gravity float, and fenced operational control."
      },
      {
        "provider_id": "robot_arm.primary.integrated",
        "required_residency": "HOT",
        "reason": "Owns Cartesian IK preview and one-shot motion execution."
      }
    ],
    "required_resources_by_capability": {
      "robot_arm.motion.free_space.preview_commit.v1": "robot_arm.primary/arm"
    },
    "preview_then_autonomous_policy_authorization": true,
    "orientation_preservation": "MEASURED_CONTROLLED_FRAME_RPY_WITH_POSE_6DOF",
    "controlled_frame_yaw_delta": {
      "composition": "R_TARGET_EQUALS_R_MEASURED_TIMES_RZ_DELTA",
      "positive_direction": "CONTROLLED_POSITIVE_X_TOWARD_POSITIVE_Y_LEFT",
      "negative_direction": "CONTROLLED_POSITIVE_X_TOWARD_NEGATIVE_Y_RIGHT",
      "maximum_absolute_degrees": 45.0,
      "rotation_only_direction": "NONE"
    },
    "controlled_frame_rpy_delta": {
      "composition": "R_TARGET_EQUALS_R_MEASURED_TIMES_RZ_YAW_RY_PITCH_RX_ROLL",
      "units": "DEGREES",
      "maximum_absolute_component_degrees": 180.0,
      "rotation_only_direction": "NONE"
    },
    "absolute_arm_base_orientation": {
      "representation": "ROLL_PITCH_YAW_RADIANS",
      "frame": "CONFIGURED_ARM_BASE",
      "rotation_only_direction": "NONE"
    },
    "translation_vector": {
      "representation": "RELATIVE_XYZ_METERS",
      "maximum_norm_m": 1.2,
      "planned_as_single_cartesian_goal": true
    },
    "motion_intents": {
      "translation": "NEW_RELATIVE_MOVE",
      "combined_translation_and_yaw": "NEW_RELATIVE_POSE_MOVE",
      "combined_translation_and_orientation": "NEW_RELATIVE_POSE_MOVE",
      "rotation_only": "NEW_RELATIVE_ROTATION"
    },
    "before_after_visual_verification": "BEST_EFFORT_WHEN_FIXED_RIG_CONFIRMED",
    "missing_visual_depth_may_veto_ik_preview": false,
    "visual_verification_is_independent_of_direction_definition": true,
    "vio_readiness_check_may_reset_epoch": false,
    "vio_readiness_check_may_acquire_global_motion_inhibit": false,
    "integrated_recovery_transition": "EXPLICIT_APPROVED_HOT",
    "physical_execution_tool": "perform_relative_effector_motion",
    "physical_execution_arguments": "CALL_SCOPED_HOST_OWNED_CONTINUATION",
    "physical_execution_maturity": "AUTONOMOUS_SIGNED_PATH_PLAN_PATH_COMMIT",
    "autonomous_execution_boundary": "SIGNED_PATH_PLAN_PATH_COMMIT_ONLY",
    "reference_agent_prepared_action_projection": {
      "tool_name": "perform_relative_effector_motion",
      "preparation_tool": "HOST_INTERNAL_CONTROLLER_PATH_PLAN",
      "continuation_tool": "HOST_INTERNAL_SIGNED_PATH_COMMIT",
      "binding": "EXACT_SDK_CALL_ID_AND_OPAQUE_PREVIEW_ID",
      "optional_for_compatible_agent_hosts": true
    },
    "explicit_world_axis_requires_reviewed_transform": true,
    "explicit_world_axis_may_use_arm_mount_fallback": false,
    "reviewed_world_transform_precedes_mount_fallback": true,
    "requested_speed_semantics": "NOMINAL_AVERAGE_ENDPOINT_SPEED",
    "requested_speed_limit_policy": "REQUESTED_SPEED_IS_CONVERTED_TO_PER_JOINT_SPEED; AUTHENTICATE_ABOVE_10_RAD_S; HARD_REJECT_AT_OR_ABOVE_20_RAD_S",
