{
  "skill_type": "integrated_relative_effector_motion",
  "version": "0.6.0",
  "display_name": "Integrated Free-Space End-Effector Motion",
  "ui": {
    "observation": {
      "kind": "MANAGER_HOSTED",
      "information_level": "RICH",
      "read_only": true
    },
    "developer": {
      "label": "Relative Motion Skill Workflow",
      "url": "http://127.0.0.1:8000/dev/skills/integrated-relative-effector-motion",
      "availability": "AGENT_RUNTIME"
    }
  },
  "lifecycle": "FINITE",
  "agent_discovery": {
    "schema_version": 2,
    "discoverable": true,
    "tool_name": "perform_relative_effector_motion",
    "description": "Perform one measured-start free-space end-effector pose move through the controller-owned signed path-plan/path-commit boundary. Fresh scenes are collision-checked; PUSHABLE is ignored, KEEP_OUT adds 10 mm, and WORK_OBJECT adds 0 mm while intersection remains forbidden. Translation accepts a signed axis or arbitrary 3D vector; orientation may be preserved, changed by controlled-frame RPY, or set in arm-base RPY. The host owns the exact preview continuation and autonomous authorization; the Agent cannot select or replay a plan ID.",
    "when_to_use": [
      "The operator requests a collision-checked free-space Cartesian translation, orientation change, or combined pose change.",
      "Manager can satisfy the declared arm Provider dependencies.",
      "A fresh measured controlled-frame pose is available.",
      "Optional fixed-rig visual evidence may be collected when available."
    ],
    "when_not_to_use": [
      "The request is safe-home, gravity float, emergency stop, or raw joint control.",
      "The request intentionally makes contact, cuts, pushes, or grips; those actions belong to separate contact or grip controllers.",
      "The arm is holding an object whose runtime attachment revision, payload, and collision geometry have not been declared to the free-space controller.",
      "The requested semantic direction cannot be resolved from an operator-confirmed mount or a measured transform."
    ],
    "side_effects": [
      "May autonomously request task-facing Provider activation; Manager resolves declared dependencies.",
      "After fixed-rig confirmation, may non-destructively start or verify camera and VIO tracking without resetting the epoch.",
      "May capture best-effort gravity-aligned effector evidence before and after an autonomous signed move.",
      "Creates an exact nonphysical Integrated Controller path preview.",
      "Autonomously authorizes and executes only that call-scoped signed free-space preview."
    ],
    "safety_class": "PHYSICAL_MOTION_AUTHORIZATION_REQUIRED",
    "expected_latency": "MEDIUM",
    "required_permissions": [
      "robot.arm.state.read",
      "robot.motion.preview"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "direction": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "NONE",
                "UP",
                "DOWN",
                "FRONT",
                "BACK",
                "LEFT",
                "RIGHT",
                "NORTH",
                "SOUTH",
                "EAST",
                "WEST",
                "POSITIVE_X",
                "NEGATIVE_X",
                "POSITIVE_Y",
                "NEGATIVE_Y",
                "POSITIVE_Z",
                "NEGATIVE_Z",
                "ARM_BASE_POSITIVE_X",
                "ARM_BASE_NEGATIVE_X",
                "ARM_BASE_POSITIVE_Y",
                "ARM_BASE_NEGATIVE_Y",
                "ARM_BASE_POSITIVE_Z",
                "ARM_BASE_NEGATIVE_Z"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "reference_frame": {
          "type": "string",
          "enum": [
            "WORLD",
            "CAMERA_LEVEL",
            "ARM_BASE"
          ],
          "default": "WORLD",
          "description": "WORLD is required for ordinary unqualified 3D language and explicit signed world axes. Explicit signed world axes require a reviewed motion-usable world-to-arm transform and cannot use the upright arm fallback. CAMERA_LEVEL is only for explicit gravity-leveled camera-relative 3D language. ARM_BASE is only for explicit ARM_BASE signed-axis commands."
        },
        "arm_mount_assumption": {
          "type": "string",
          "enum": [
            "UNKNOWN",
            "CONFIRMED_X_FORWARD_Z_UP",
            "REJECTED_OR_UNKNOWN"
          ],
          "default": "UNKNOWN",
          "description": "Use CONFIRMED_X_FORWARD_Z_UP only after the operator explicitly confirms base +Z opposite gravity and base +X along workcell front."
        },
        "camera_level_assumption": {
          "type": "string",
          "enum": [
            "UNKNOWN",
            "CONFIRMED_GRAVITY_LEVELED",
            "REJECTED_OR_UNKNOWN"
          ],
          "default": "UNKNOWN",
          "description": "Use CONFIRMED_GRAVITY_LEVELED only after the operator confirms that camera front/left/right ignore pitch and roll and up is opposite gravity."
        },
        "fixed_vio_rig_assumption": {
          "type": "string",
          "enum": [
            "UNKNOWN",
            "CONFIRMED_FIXED_STATIONARY_RIG",
            "REJECTED_OR_UNKNOWN"
          ],
          "default": "UNKNOWN",
          "description": "Use CONFIRMED_FIXED_STATIONARY_RIG only after the operator confirms the camera and IMU are rigidly fixed together and can remain stationary for VIO checking and before/after visual evidence."
        },
        "orientation_policy": {
          "type": "string",
          "enum": [
            "POSITION_ONLY",
            "PRESERVE_MEASURED_CONTROLLED_FRAME",
            "APPLY_CONTROLLED_FRAME_YAW_DELTA",
            "APPLY_CONTROLLED_FRAME_RPY_DELTA",
            "SET_ARM_BASE_RPY"
          ],
          "default": "POSITION_ONLY",
          "description": "PRESERVE_MEASURED_CONTROLLED_FRAME retains the measured attitude. APPLY_CONTROLLED_FRAME_YAW_DELTA is the bounded legacy yaw policy. APPLY_CONTROLLED_FRAME_RPY_DELTA postmultiplies one conventional Rz(yaw) Ry(pitch) Rx(roll) delta onto the measured controlled frame. SET_ARM_BASE_RPY binds an absolute arm-base RPY target. Every non-position policy binds an exact POSE_6DOF target."
        },
        "controlled_frame_yaw_delta_deg": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -45.0,
              "maximum": 45.0
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required and nonzero only for APPLY_CONTROLLED_FRAME_YAW_DELTA. This is intrinsic yaw about the measured controlled +Z axis: positive turns controlled +X toward +Y (left), and negative turns it toward -Y (right)."
        },
        "controlled_frame_rpy_delta_deg": {
          "anyOf": [
            {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number",
                "minimum": -180.0,
                "maximum": 180.0
              }
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required and nonzero only for APPLY_CONTROLLED_FRAME_RPY_DELTA. Values are controlled-frame-relative roll, pitch, and yaw deltas in degrees. The exact composition is R_target = R_measured Rz(yaw) Ry(pitch) Rx(roll)."
        },
        "target_orientation_rpy_rad": {
          "anyOf": [
            {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required only for SET_ARM_BASE_RPY. This is the exact absolute roll, pitch, yaw target in radians in the configured arm-base frame."
        },
        "distance_m": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.2
            },
            {
              "type": "null"
            }
          ],
          "description": "Translation distance. Use exactly 0 with direction NONE for rotation-only motion; positive free-space translations must be from 0.001 to 1.2 m."
        },
        "translation_vector_m": {
          "anyOf": [
            {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number",
                "minimum": -1.2,
                "maximum": 1.2
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "One arbitrary relative displacement vector [x, y, z] in reference_frame, in meters. Its norm must be 0.001 to 1.2 m. Do not also provide direction or distance_m. The controller plans it as one combined Cartesian goal, not three axis moves."
        },
        "requested_speed_m_s": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0.0
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional nominal average endpoint speed. The adapter requests distance_m / requested_speed_m_s seconds; the Provider may lengthen the trajectory for joint-rate safety. This is not constant instantaneous Cartesian velocity."
        },
        "execution_backend": {
          "type": "string",
          "enum": [
            "IMPEDANCE",
            "POS_SPEED"
          ],
          "default": "IMPEDANCE",
          "description": "Integrated Basic command backend for this signed path. IMPEDANCE is the default 50 Hz position-and-velocity-target stream. POS_SPEED selects 50 Hz POSITION_VELOCITY_LIMITED position targets; its timing is recomputed from Basic's POS_SPEED limits."
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "status": {"type": "string"},
        "workflow_complete": {"type": "boolean"},
        "physical_motion_authorized": {"type": ["boolean", "null"]},
        "physical_motion_submitted": {"type": ["boolean", "null"]},
        "physical_motion_requested": {"type": "boolean"},
