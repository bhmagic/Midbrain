{
  "skill_type": "locate_arm_base",
  "version": "1.8.1",
  "display_name": "Locate Arm Base",
  "description": "Locate a profiled robot arm base from CAD and current RGB-D evidence, resolve only model-profile orientation candidates with reference-image VLM evidence, and emit a review-only world transform candidate.",
  "lifecycle": "FINITE",
  "agent_discovery": {
    "schema_version": 3,
    "discoverable": true,
    "tool_name": "locate_arm_base",
    "description": "Locate the stationary robot arm base in the current world frame. The Skill owns the base CAD and reference images, creates configurable independent VLM-to-SAM2 masks, removes bad masks with VLM review, pixel-votes and dilates the survivors once, repeats independent fits of that final mask through the generic FoundationPose Provider, normalizes only the known upside-down pose family with a world-verified local-X half-turn, and asks the VLM to select only a profiled local-Z rotation. It creates a non-motion-usable candidate that must be reviewed and activated by Manager. When used in a Limited Graph, allocate at least 180 seconds.",
    "when_to_use": [
      "The current stationary camera rig needs a reviewed world-to-arm-base transform.",
      "The arm base is visible in current aligned RGB-D evidence and the current world axis is established.",
      "A replaceable end effector makes gripper-dependent arm-base orientation assumptions invalid."
    ],
    "when_not_to_use": [
      "Only the VIO world axis or world origin is requested.",
      "The arm base or camera rig is moving during capture.",
      "The requested robot base has no immutable Skill-owned model profile."
    ],
    "side_effects": [
      "Captures one current aligned RGB-D snapshot and invokes independent VLM seed prompts, independent SAM2 masks, VLM bad-mask review, a coded half-survivor pixel vote, fit-candidate selection, and orientation selection.",
      "Requests HOT residency for the assembly-selected arm Provider through Manager and waits for its profile-binding state.",
      "Temporarily activates the generic SAM2 segmentation and FoundationPose pose Providers through Manager and performs the configured number of independent fits on the voted and once-dilated mask.",
      "Persists and publishes one immutable review-only calibration candidate; it does not move hardware or activate the transform."
    ],
    "safety_class": "STATEFUL_NO_MOTION",
    "expected_latency": "MEDIUM",
    "required_permissions": [
      "camera.read",
      "world.transforms.read",
      "vlm.invoke",
      "calibration.candidate.write"
    ],
    "input_schema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "output_schema": {
