{
  "skill_type": "initialize_space_cognition",
  "version": "0.2.0",
  "display_name": "Initialize / Re-establish Space Cognition",
  "ui": {
    "observation": {
      "kind": "MANAGER_HOSTED",
      "information_level": "RICH",
      "read_only": true
    },
    "developer": {
      "label": "Space Cognition Development Controls",
      "url": "http://127.0.0.1:8000/dev/skills/initialize-space-cognition",
      "availability": "AGENT_RUNTIME"
    }
  },
  "lifecycle": "FINITE",
  "agent_discovery": {
    "schema_version": 3,
    "discoverable": true,
    "tool_name": "reinitialize_space_cognition",
    "description": "Deliberately establish a new local spatial origin from the robot's current stationary pose. This resets the Local VIO session epoch, clears epoch-bound accumulated world observations, and revokes active stationary-workcell calibrations before the origin changes. Use it to recover from VIO drift or to define a new local origin, not as a routine readiness check.",
    "when_to_use": [
      "The operator explicitly asks to reset, re-zero, re-origin, or readjust Midbrain's local spatial frame.",
      "Local VIO has drifted or recovered with an origin that the operator no longer accepts.",
      "A new physical setup requires all subsequent world-space observations to use a fresh epoch."
    ],
    "when_not_to_use": [
      "The request only needs camera or VIO Providers started; use Provider lifecycle control instead.",
      "An existing TRACKING epoch remains suitable for the task.",
      "The robot or camera cannot remain stationary during gravity and origin initialization."
    ],
    "side_effects": [
      "Acquires a Manager motion-inhibit lease while the spatial origin is established.",
      "May start the camera and Local VIO Providers.",
      "Revokes active stationary-workcell calibrations before changing the VIO epoch.",
      "Clears accumulated world-point observations that belong to the previous epoch."
    ],
    "safety_class": "STATEFUL_NO_MOTION",
    "expected_latency": "HIGH",
    "required_permissions": [
      "camera.read",
      "localization.vio.reset",
      "motion.inhibit",
      "workcell.calibration.revoke"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300,
          "description": "Why a new local spatial origin is required."
        }
      },
      "required": [
        "reason"
      ],
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "status": {"const": "initialized"},
        "message": {"type": "string"},
        "requested_reason": {"type": "string"},
        "point_cloud_resumed": {"type": "boolean"},
        "result": {
          "type": "object",
          "properties": {
            "skill_id": {"type": "string"},
            "session_epoch": {"type": "string"},
            "world_frame": {"type": "string"},
            "body_frame": {"type": "string"},
            "selected_providers": {"type": "object"},
            "reused_physical_provider": {"type": "boolean"},
            "motion_inhibit": {"type": ["object", "null"]},
            "operation": {"type": "string"},
            "previous_session_epoch": {"type": ["string", "null"]},
            "invalidated_workcell_activation_ids": {"type": "array", "items": {"type": "string"}}
          },
          "required": [
            "skill_id", "session_epoch", "world_frame", "body_frame",
            "selected_providers", "reused_physical_provider",
            "motion_inhibit", "operation", "previous_session_epoch",
            "invalidated_workcell_activation_ids"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "status", "message", "requested_reason", "point_cloud_resumed",
        "result"
      ],
      "additionalProperties": false,
      "x-midbrain-result-tiers": {
        "schema_version": 1,
        "compact_pointers": [
          "/status", "/message", "/requested_reason", "/point_cloud_resumed",
          "/result/skill_id", "/result/session_epoch", "/result/world_frame",
          "/result/body_frame", "/result/operation",
          "/result/previous_session_epoch",
          "/result/invalidated_workcell_activation_ids"
        ],
        "detail_policy": "HOST_SANITIZED_REFERENCE",
        "max_compact_bytes": 16384
      }
    },
    "execution_adapter": {
      "adapter_id": "skill.initialize_space_cognition.reinitialize.v1",
      "kind": "IN_PROCESS_BOUND_INSTANCE",
      "invocation_requires_approval": true
    }
  },
  "required_capabilities": [
    "camera.rgb",
    "camera.depth_aligned_to_rgb",
    "camera.imu.accel",
    "camera.imu.gyro",
    "localization.vio.local_pose"
  ],
  "runtime_readiness_check": {
    "operation": "VERIFY_EXISTING_EPOCH",
    "requires_fixed_stationary_rig_confirmation": true,
    "may_start_camera_and_vio_providers": true,
    "may_reset_vio_epoch": false,
    "may_revoke_workcell_calibrations": false,
    "holds_motion_inhibit_until_tracking": false,
    "uses_local_vio_fixed_rig_attestation": true,
    "may_revoke_arm_controller_lease": false
  },
  "published_streams": [
    "skills.initialize_space_cognition.status"
  ],
  "epoch_contract": {
    "creates_new_epoch": true,
    "old_epoch_data_remains_historical_only": true,
    "active_workcell_calibrations_revoked_before_reset": true,
    "downstream_consumers_must_match_session_epoch": true
  }
}
