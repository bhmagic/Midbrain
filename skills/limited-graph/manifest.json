  "required_capabilities": [],
  "optional_capabilities": [],
  "route_policy": {
    "graph_schema_version": 1,
    "sequential_execution_only": true,
    "nested_graphs_allowed": false,
    "dynamic_nodes_allowed": false,
    "child_eligibility": "CURRENT_AGENT_HOST_INTERSECTION",
    "child_authorization": "REVALIDATE_EACH_EXACT_INVOCATION",
