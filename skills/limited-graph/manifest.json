        "compact_pointers": [
          "/schema", "/schema_version", "/graph_run_id", "/graph_sha256",
          "/graph_name", "/status", "/terminal_node", "/message",
          "/last_completed_node", "/active_runtime_ms", "/transition_count",
          "/last_failure",
          "/node_visits", "/retry_count", "/model_route_count",
          "/physical_action_count", "/retained_result_bytes", "/limit",
          "/node_results"
        ],
        "detail_policy": "HOST_SANITIZED_REFERENCE",
        "max_compact_bytes": 131072
      }
    },
    "execution_adapter": {
      "adapter_id": "skill.limited_graph.host.v1",
      "kind": "EXTERNAL_SKILL_ENTRYPOINT",
      "entrypoint": "python/limited_graph/runner.py",
      "host_adapter": {
        "entrypoint": "python/limited_graph/host_adapter.py",
