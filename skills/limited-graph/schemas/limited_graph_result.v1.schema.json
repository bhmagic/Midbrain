{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://midbrain.local/schemas/limited_graph_result.v1.schema.json",
  "title": "Midbrain Limited Graph Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "status",
    "message",
    "graph_run_id",
    "graph_sha256",
    "graph_name",
    "terminal_node",
    "last_completed_node",
    "last_failure",
    "active_runtime_ms",
    "transition_count",
    "node_visits",
    "retry_count",
    "model_route_count",
    "physical_action_count",
    "retained_result_bytes",
    "limit",
    "authorization",
    "trace",
    "node_results"
  ],
  "properties": {
    "schema": {"const": "midbrain.limited_graph.result"},
    "schema_version": {"const": 1},
    "status": {"type": "string", "minLength": 2},
    "message": {"type": "string"},
    "graph_run_id": {"type": "string", "minLength": 16},
    "graph_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "graph_name": {"type": "string", "minLength": 1},
    "terminal_node": {"type": ["string", "null"]},
    "last_completed_node": {"type": ["string", "null"]},
    "last_failure": {
      "type": ["object", "null"],
      "properties": {
        "kind": {"type": "string", "minLength": 2},
        "node_id": {"type": ["string", "null"]},
        "tool_name": {"type": ["string", "null"]},
        "reason": {"type": "string"},
        "physical_action_submitted": {"type": ["boolean", "null"]}
      },
      "required": [
        "kind",
        "node_id",
        "tool_name",
        "reason",
        "physical_action_submitted"
      ],
      "additionalProperties": false
    },
    "active_runtime_ms": {"type": "number", "minimum": 0},
    "transition_count": {"type": "integer", "minimum": 0},
    "node_visits": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
    "retry_count": {"type": "integer", "minimum": 0},
    "model_route_count": {"type": "integer", "minimum": 0},
    "physical_action_count": {"type": "integer", "minimum": 0},
    "retained_result_bytes": {"type": "integer", "minimum": 0},
    "limit": {"type": ["string", "null"]},
    "authorization": {"type": ["object", "null"]},
    "trace": {"type": "array", "items": {"type": "object"}},
    "node_results": {"type": "object"}
  }
}
