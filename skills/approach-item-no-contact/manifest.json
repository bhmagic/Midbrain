{
  "skill_type": "approach_item_no_contact",
  "version": "0.1.6",
  "display_name": "Plan No-Contact Item Approach",
  "lifecycle": "FINITE",
  "agent_discovery": {
    "schema_version": 2,
    "discoverable": true,
    "tool_name": "plan_no_contact_item_approach",
    "description": "Locate one visible item and the effector front in parallel, express both in rebot_arm_base, and plan a Cartesian correction to the requested no-contact boundary. Wording such as reach, touch, until reaching, or until touching describes the boundary destination and is not contact authorization. Observation uncertainty remains explicit evidence instead of becoming a hidden clearance margin. The default extra WORK_OBJECT standoff is 0 mm; Integrated prevents intersection, keeps 10 mm from KEEP_OUT obstacles, and may truncate at closest-safe. The adapter requests a shadow preview and returns an exact autonomously signed execution continuation. Both landmarks are observed again for residual realignment. This planning Skill never submits motion.",
    "when_to_use": [
      "The robot should move close to a visible item without touching or pushing it.",
      "The robot should reach or move until touching a visible item, interpreted as stopping at the no-contact boundary.",
      "An Agent needs one correction from current visual item and effector evidence.",
      "A previous correction completed and both landmarks must be realigned."
    ],
    "when_not_to_use": [
      "The item has only bearing evidence and no metric or task-plane point.",
      "The camera-to-arm-base calibration is unavailable or stale.",
      "The request explicitly requires sustained force work such as grasping, pushing, pressing, cutting, or scraping."
    ],
    "side_effects": [
      "Reads synchronized RGB-D and arm-base transform evidence for two parallel locator calls.",
      "May call the configured VLM twice in parallel and write diagnostic evidence images.",
      "May request a nonphysical Integrated-controller shadow preview through the host adapter.",
      "Returns an exact execution continuation but does not authorize or execute it."
    ],
    "safety_class": "READ_ONLY",
    "expected_latency": "MEDIUM",
    "required_permissions": [
      "camera.read",
      "world.transforms.read",
      "robot.transforms.read",
      "vlm.invoke"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string",
          "description": "Complete description of the one visible item to approach."
        },
        "object_id": {
          "anyOf": [
            {"type": "string"},
            {"type": "null"}
          ],
          "default": null,
          "description": "Optional stable object ID supplied by the upstream Agent."
        },
        "requested_standoff_m": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 0.5,
          "default": 0.0,
          "description": "Extra requested standoff from the work object. Defaults to zero; Integrated semantic collision geometry prevents contact and may return closest-safe."
        },
        "iteration_index": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "maximum_iterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 6
        },
        "maximum_step_m": {
          "type": "number",
          "minimum": 0.005,
          "maximum": 1.2,
          "default": 1.2,
          "description": "Optional explicit correction cap. The default spans the complete 1.2 m arm ROI so normal requests target the destination rather than an arbitrary 5 cm segment."
        },
        "vertical_policy": {
          "type": "string",
          "enum": ["NO_DESCENT", "PRESERVE_CURRENT_HEIGHT", "FREE_3D"],
          "default": "FREE_3D",
          "description": "Vertical correction policy. FREE_3D relies on the required semantic-scene collision preview; PRESERVE_CURRENT_HEIGHT forces a horizontal correction."
        }
      },
      "required": ["question"],
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "schema": {"type": "string"},
        "schema_version": {"type": "integer"},
        "status": {"type": "string"},
        "workflow_complete": {"type": "boolean"},
        "physical_motion_authorized": {"type": "boolean"},
        "motion_submitted": {"type": "boolean"},
        "target_frame": {"type": "string"},
        "object_id": {"type": ["string", "null"]},
        "iteration_index": {"type": "integer"},
        "maximum_iterations": {"type": "integer"},
        "requested_standoff_m": {"type": "number"},
        "current_distance_to_item_m": {"type": "number"},
        "predicted_distance_to_item_m": {"type": "number"},
        "effective_standoff_m": {"type": "number"},
        "alignment_tolerance_m": {"type": "number"},
        "combined_uncertainty_m": {"type": "number"},
        "item_point_arm_base_m": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
        "effector_point_arm_base_m": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
        "controller_tool_point_arm_base_m": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
        "controller_reference_source": {"type": "string"},
        "desired_effector_point_arm_base_m": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
        "unconstrained_desired_effector_point_arm_base_m": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
        "vertical_policy": {"type": "string"},
        "predicted_effector_point_arm_base_m": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
        "next_target_arm_base_m": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
        "controller_target_policy": {"type": "string"},
        "full_correction_vector_m": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
        "step_distance_m": {"type": "number"},
        "maximum_step_m": {"type": "number"},
        "maximum_arm_radius_m": {"type": "number"},
        "arm_radius_policy": {"type": "string"},
        "observation_skew_ms": {"type": "number"},
        "planned_at_us": {"type": "integer"},
        "contact_policy": {"type": "object"},
        "controller_plan_request": {"type": ["object", "null"]},
        "required_before_motion": {"type": "array", "items": {"type": "string"}},
        "required_after_motion": {"type": "array", "items": {"type": "string"}},
        "next_action": {"type": "string"},
        "source_evidence": {"type": "object"},
        "reason": {"type": "string"},
        "correction_status": {"type": "string"},
        "controller_preview": {"type": "object"},
        "controller_preview_received": {"type": "boolean"},
        "controller_preview_authority": {"type": "object"},
        "controller_preview_validation_issues": {"type": "array", "items": {"type": "string"}},
        "controller_preview_valid": {"type": "boolean"},
        "motion_usable": {"type": "boolean"},
        "goal_reached": {"type": "boolean"},
        "closest_safe": {"type": "boolean"},
        "motion_outcome": {"type": ["string", "object", "null"]},
        "closest_safe_report": {"type": "object"},
        "execution_adapter_available": {"type": "boolean"},
        "required_next_tool": {"type": ["object", "null"]},
        "retry_after_prerequisite": {"type": ["object", "null"]},
        "message": {"type": "string"}
      },
      "required": [
        "schema", "schema_version", "status", "workflow_complete",
        "physical_motion_authorized", "motion_submitted", "target_frame",
        "object_id", "contact_policy", "next_action", "source_evidence"
      ],
      "additionalProperties": true
    },
    "execution_adapter": {
      "adapter_id": "skill.approach_item_no_contact.plan.v1",
      "kind": "IN_PROCESS_BOUND_INSTANCE",
      "invocation_requires_approval": false
    }
  },
  "required_capabilities": [
    "camera.rgb",
    "camera.depth_aligned_to_rgb",
    "world.transforms.timestamped",
    "robot_arm.transforms.local",
    "world_model.arm.semantic_scene",
    "perception.vision_language",
    "robot.motion.arm.integrated.plan.transit_path.shadow"
  ],
  "optional_capabilities": [
    "camera.rgbd.route.generic_shared_memory",
    "camera.rgbd.route.direct_shared_memory"
  ],
  "route_policy": {
    "required_route_count": 1,
    "preference_order": [
      "camera.rgbd.route.generic_shared_memory",
      "camera.rgbd.route.direct_shared_memory"
    ],
    "selection_time": "EXECUTION",
    "explicit_provider_fallback_allowed": true
  },
  "result_policy": {
    "motion_usable": false,
    "physical_motion_authorized": false,
    "destination_move_requires_residual_reobservation": true,
    "allowed_contact_object_ids": [],
    "permit_pushable_contact": false,
    "work_object_extra_clearance_m": 0.0,
    "keep_out_clearance_m": 0.01,
    "contact_intersection_permitted": false,
    "boundary_wording_is_contact_authorization": false
  },
  "published_streams": []
}
