{
  "skill_type": "observe_pointed_object",
  "version": "0.2.2",
  "display_name": "Locate Visible Item",
  "lifecycle": "FINITE",
  "agent_discovery": {
    "schema_version": 3,
    "discoverable": true,
    "tool_name": "locate_item",
    "description": "Identify and locate one visible requested item in 3D, metric, depth, world, camera, or robot coordinates using synchronized RGB-D evidence. This is the mandatory Skill whenever a request combines object identification with 3D location; do not substitute the RGB-only analyze_visual_scene tool. It returns a metric workpiece point when depth is trustworthy, a task-plane intersection when supplied, or explicit bearing-only evidence with an active-perception recommendation. A successful metric result publishes a short-lived Fabric workpiece assertion for the HOT scene compiler; it never moves the robot or treats reflective/transparent background depth as item geometry.",
    "when_to_use": [
      "An Agent or Skill needs a metric item point before planning a no-contact approach.",
      "The user asks to identify an object and locate it in 3D, metric, depth, world-frame, camera-frame, or robot-frame coordinates.",
      "A visible reflective or transparent target needs a non-error-only degraded fallback.",
      "A fixed-altitude request can supply a task plane for ray-plane intersection."
    ],
    "when_not_to_use": [
      "The target item is not visible or is ambiguous.",
      "A full six-degree-of-freedom CAD object pose is required.",
      "The result would be treated as motion authorization without a separate controller preview."
    ],
    "side_effects": [
      "Reads one synchronized RGB-D frame and one timestamped transform.",
      "Calls the configured VLM once and may write a diagnostic evidence image.",
      "A metric result publishes or refreshes a short-lived WORKPIECE assertion in Fabric; publication failure is reported without discarding the location.",
      "Does not stage, authorize, or execute motion."
    ],
    "safety_class": "STATEFUL_NO_MOTION",
    "expected_latency": "MEDIUM",
    "required_permissions": [
      "camera.read",
      "world.transforms.read",
      "vlm.invoke",
      "world_state.write"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string",
          "description": "Complete description of the one visible item to locate."
        },
        "target_frame": {
          "type": "string",
          "description": "Frame in which metric point or bearing evidence is returned. Use CURRENT_WORLD for the live VIO world frame without locating the arm base; use rebot_arm_base only when an active world-to-arm relationship is actually required."
        },
        "object_id": {
          "anyOf": [
            {"type": "string"},
            {"type": "null"}
          ],
          "default": null,
          "description": "Optional upstream stable object ID."
        },
        "contact_policy": {
          "type": "string",
          "enum": [
            "WORKPIECE_CONTACT_ALLOWED",
            "NO_CONTACT"
          ],
          "default": "WORKPIECE_CONTACT_ALLOWED"
        },
        "depth_requirement": {
          "type": "string",
          "enum": [
            "PREFER_METRIC",
            "REQUIRE_METRIC",
            "ALLOW_BEARING"
          ],
          "default": "PREFER_METRIC"
        },
        "task_plane": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "plane_id": {"type": "string"},
                "normal_target": {
                  "type": "array",
                  "items": {"type": "number"},
                  "minItems": 3,
                  "maxItems": 3
                },
                "offset_m": {"type": "number"},
                "uncertainty_m": {"type": "number", "exclusiveMinimum": 0.0}
              },
              "required": ["plane_id", "normal_target", "offset_m", "uncertainty_m"],
              "additionalProperties": false
            },
            {"type": "null"}
          ],
          "default": null
        }
      },
      "required": [
        "question",
        "target_frame"
      ],
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "schema": {"const": "physical_agent.item_location"},
        "schema_version": {"const": 1},
        "status": {"type": "string"},
        "eligible_for_control_math": {"type": "boolean"},
        "motion_usable": {"type": "boolean"},
        "object_id": {"type": "string"},
        "item_label": {"type": "string"},
        "semantic_role": {"type": "string"},
        "contact_policy": {"type": "string"},
        "quality_reasons": {"type": "array", "items": {"type": "string"}},
        "vlm_reason": {"type": ["string", "null"]},
        "observed_at_us": {"type": "integer"},
        "source_frame": {"type": "string"},
        "target_frame": {"type": "string"},
        "calibration_revision": {"type": ["string", "null"]},
        "material_class": {"type": "string"},
        "metric_source": {"type": "string"},
        "location": {
          "type": ["object", "null"],
          "properties": {
            "target_point_m": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
            "uncertainty_radius_m": {"type": "number"}
          },
          "required": ["target_point_m", "uncertainty_radius_m"],
          "additionalProperties": false
        },
        "camera_system_point_m": {
          "type": ["object", "null"],
          "properties": {
            "camera_system_x": {"type": "number"},
            "camera_system_y": {"type": "number"},
            "camera_system_z": {"type": "number"}
          },
          "required": ["camera_system_x", "camera_system_y", "camera_system_z"],
          "additionalProperties": false
        },
        "bearing": {
          "type": "object",
          "properties": {
            "target_origin_m": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
            "target_unit_direction": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
            "camera_ray_xyz": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
            "source_pixel_yx": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer"}}
          },
          "required": ["target_origin_m", "target_unit_direction", "camera_ray_xyz", "source_pixel_yx"],
          "additionalProperties": false
        },
        "depth_evidence": {"type": ["object", "null"]},
        "rejected_depth_evidence": {"type": ["object", "null"]},
        "task_plane_evidence": {"type": ["object", "null"]},
        "volume_hint": {"type": ["object", "null"]},
        "degraded_reason": {"type": ["string", "null"]},
        "recommended_next_action": {"type": ["string", "null"]},
        "vlm_provenance": {"type": "object"},
        "registration_transform": {"type": "object"},
        "data_route": {"type": "object"},
        "skill_id": {"type": "string"},
        "safety_class": {"type": "string"},
        "physical_action_submitted": {"type": "boolean"},
        "control_frame_published": {"type": "boolean"},
        "capability_binding": {"type": "object"},
        "binding_mode": {"type": "string"},
        "generic_route_mode": {"type": "string"},
        "camera_capture": {"type": "object"},
        "transform_provenance": {"type": "object"},
        "selected_route_metadata": {"type": "object"},
        "source_convention_id": {"type": "string"},
        "target_convention_id": {"type": "string"},
        "vlm_route": {"type": "object"},
        "vlm_geometry": {"type": "object"},
        "vlm_evidence": {"type": "object"},
        "visual_box_support": {"type": "object"},
        "evidence_image": {"type": ["object", "null"]},
        "visual_evidence": {"type": ["object", "null"]},
        "input_temporal_evidence": {"type": "object"},
        "semantic_scene_assertion": {"type": "object"}
      },
      "required": [
        "schema", "schema_version", "status", "eligible_for_control_math",
        "motion_usable", "object_id", "item_label", "semantic_role",
        "contact_policy", "quality_reasons", "vlm_reason", "skill_id",
        "safety_class", "physical_action_submitted",
        "control_frame_published", "capability_binding", "binding_mode",
        "generic_route_mode", "camera_capture", "transform_provenance",
        "selected_route_metadata", "source_convention_id",
        "target_convention_id", "vlm_route", "vlm_geometry",
        "vlm_evidence", "visual_box_support", "evidence_image",
        "visual_evidence", "input_temporal_evidence",
        "semantic_scene_assertion"
      ],
      "additionalProperties": false,
      "x-midbrain-result-tiers": {
        "schema_version": 1,
        "compact_pointers": [
          "/schema", "/schema_version", "/status", "/eligible_for_control_math",
          "/motion_usable", "/object_id", "/item_label", "/semantic_role",
          "/contact_policy", "/quality_reasons", "/vlm_reason",
          "/observed_at_us", "/source_frame", "/target_frame",
          "/calibration_revision", "/material_class", "/metric_source",
          "/location", "/bearing", "/degraded_reason",
          "/recommended_next_action", "/physical_action_submitted",
          "/source_convention_id", "/target_convention_id", "/visual_evidence"
        ],
        "detail_policy": "HOST_SANITIZED_REFERENCE",
        "max_compact_bytes": 32768
      }
    },
    "execution_adapter": {
      "adapter_id": "skill.observe_pointed_object.locate.v2",
      "kind": "IN_PROCESS_BOUND_INSTANCE",
      "invocation_requires_approval": false
    }
  },
  "required_capabilities": [
    "camera.rgb",
    "camera.depth_aligned_to_rgb",
    "world.transforms.timestamped",
    "perception.vision_language"
  ],
  "optional_capabilities": [
    "camera.rgbd.route.generic_shared_memory",
    "camera.rgbd.route.direct_shared_memory"
  ],
  "route_policy": {
    "required_route_count": 1,
    "preference_order": [
      "camera.rgbd.route.generic_shared_memory",
      "camera.rgbd.route.direct_shared_memory"
    ],
    "selection_time": "EXECUTION",
    "explicit_provider_fallback_allowed": true
  },
  "result_policy": {
    "motion_usable": false,
    "physical_motion_authorized": false,
    "semantic_role": "WORKPIECE",
    "reflective_or_transparent_background_depth_allowed": false,
    "degraded_result_is_not_collision_authority": true
  },
  "published_streams": [
    "robot_arm.scene.semantic_assertions"
  ]
}
