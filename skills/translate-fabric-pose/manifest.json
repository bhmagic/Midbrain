{
  "skill_type": "translate_fabric_pose",
  "version": "0.1.0",
  "display_name": "Translate Fabric Pose to World",
  "lifecycle": "FINITE",
  "agent_discovery": {
    "schema_version": 3,
    "discoverable": true,
    "tool_name": "translate_fabric_pose_to_world",
    "description": "Rigidly transform one metric position plus XYZW orientation from active-world, configured arm-base, or current controlled-effector coordinates into the active Fabric world frame. The read-only result exposes target_position_world_m and target_orientation_world_xyzw with frame, epoch, calibration, timestamp, and transform-path provenance. It performs no movement and does not create a world-pose motion authority.",
    "when_to_use": [
      "A downstream operation requires a complete world pose derived from arm-base or controlled-effector coordinates.",
      "Position and orientation must be transformed together without language-model matrix or quaternion math.",
      "A typed, timestamped world-pose result is needed for a later independently authorized operation."
    ],
    "when_not_to_use": [
      "Only a direction or semantic work-object AABB point is required.",
      "The source position, quaternion convention, or source axes are ambiguous.",
      "No active motion-usable world-frame authority is available."
    ],
    "side_effects": [],
    "safety_class": "READ_ONLY",
    "expected_latency": "LOW",
    "required_permissions": [
      "world.transforms.read"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "position_m": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"type": "number"},
          "description": "Source-frame [x, y, z] position in metres."
        },
        "orientation_xyzw": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"type": "number"},
          "description": "Source-frame quaternion [x, y, z, w] describing the posed frame orientation. The Skill validates and normalizes it."
        },
        "source_reference": {
          "type": "string",
          "enum": [
            "ACTIVE_WORLD",
            "ARM_BASE",
            "CONTROLLED_EFFECTOR_FRAME"
          ],
          "description": "Frame in which both position_m and orientation_xyzw are expressed."
        },
        "source_frame_id": {
          "anyOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ],
          "description": "Optional exact upstream frame ID. Supply it unchanged when available; otherwise use null and the Skill binds the configured frame selected by source_reference."
        },
        "source_observed_at_us": {
          "anyOf": [
            {"type": "integer", "minimum": 1},
            {"type": "null"}
          ],
          "description": "Optional upstream observation timestamp in Unix microseconds. Supply it unchanged when available; use null to request the current transform."
        },
        "source_session_epoch": {
          "anyOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ],
          "description": "Optional upstream resettable-frame epoch. Supply it unchanged when available; otherwise use null."
        }
      },
      "required": [
        "position_m",
        "orientation_xyzw",
        "source_reference",
        "source_frame_id",
        "source_observed_at_us",
        "source_session_epoch"
      ],
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "schema": {"type": "string"},
        "schema_version": {"type": "integer"},
        "status": {"type": "string"},
        "workflow_complete": {"type": "boolean"},
        "physical_motion_authorized": {"type": "boolean"},
        "physical_motion_submitted": {"type": "boolean"},
        "translation_id": {"type": "string"},
        "convention_id": {"type": "string"},
        "target_position_world_m": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
        "target_orientation_world_xyzw": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
        "target_world_frame_id": {"type": "string"},
        "target_session_epoch": {"type": "string"},
        "coordinate_at_us": {"type": "integer"},
        "translated_at_us": {"type": "integer"},
        "calibration_revision": {"type": ["string", "null"]},
        "framed_pose_world": {
          "type": "object",
          "properties": {
            "position_m": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
            "orientation_xyzw": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
            "frame_id": {"type": "string"},
            "convention_id": {"type": "string"},
            "observed_at_us": {"type": "integer"},
            "session_epoch": {"type": "string"},
            "calibration_revision": {"type": ["string", "null"]},
            "transform_path": {"type": "array"}
          },
          "required": ["position_m", "orientation_xyzw", "frame_id", "convention_id", "observed_at_us", "session_epoch", "calibration_revision", "transform_path"],
          "additionalProperties": false
        },
        "source": {"type": "object"},
        "derivation": {"type": "object"},
        "supplied_source_frame_id": {"type": "string"},
        "active_source_frame_id": {"type": "string"},
        "source_frame_id": {"type": "string"},
        "source_world_binding": {"type": "object"},
        "active_world_binding": {"type": "object"},
        "required_next_tool": {"type": ["object", "null"]},
        "message": {"type": "string"}
      },
      "required": ["status", "workflow_complete", "physical_motion_authorized", "physical_motion_submitted"],
      "additionalProperties": true,
      "x-midbrain-result-tiers": {
        "schema_version": 1,
        "compact_pointers": [
          "/status", "/workflow_complete", "/physical_motion_authorized",
          "/physical_motion_submitted", "/target_position_world_m",
          "/target_orientation_world_xyzw", "/framed_pose_world",
          "/source_frame_id", "/target_world_frame_id", "/target_session_epoch",
          "/convention_id", "/calibration_revision",
          "/source_world_binding", "/active_world_binding",
          "/required_next_tool", "/message"
        ],
        "detail_policy": "HOST_SANITIZED_REFERENCE",
        "max_compact_bytes": 32768
      }
    },
    "execution_adapter": {
      "adapter_id": "skill.translate_fabric_pose.v1",
      "kind": "IN_PROCESS_BOUND_INSTANCE",
      "invocation_requires_approval": false
    }
  },
  "required_capabilities": [
    "world.transforms.timestamped"
  ],
  "optional_capabilities": [
    "robot_arm.transforms.local"
  ],
  "route_policy": {
    "output_position_field": "target_position_world_m",
    "output_orientation_field": "target_orientation_world_xyzw",
    "orientation_representation": "QUATERNION_XYZW",
    "position_units": "METRES",
    "physical_authority": "NONE"
  },
  "published_streams": []
}
