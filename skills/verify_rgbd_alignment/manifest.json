{
  "skill_type": "verify_rgbd_alignment",
  "version": "0.1.0",
  "display_name": "Verify RGB-D Image Content and Alignment",
  "ui": {
    "observation": {
      "kind": "MANAGER_HOSTED",
      "information_level": "RICH",
      "read_only": true
    },
    "developer": {
      "label": "RGB-D Content and Registration Review",
      "url": "http://127.0.0.1:8000/dev/skills/verify-rgbd-alignment",
      "availability": "AGENT_RUNTIME"
    }
  },
  "lifecycle": "FINITE",
  "agent_discovery": {
    "schema_version": 3,
    "discoverable": true,
    "tool_name": "verify_rgbd_image_alignment",
    "description": "Validate one synchronized RGB-D bundle by checking its actual grids, frame timestamps, registered-depth boundary, shared-memory route, numeric edge correspondence, and a VLM review of the RGB, registered-depth, and overlay image content. Use this read-only Skill before metric registration when image presence alone is insufficient.",
    "when_to_use": [
      "RGB, depth, IR, or registered depth may have different resolution, aspect ratio, boundary, timestamp, or frame rate.",
      "A spatial or motion-related operation needs evidence that registered depth depicts and aligns with the RGB scene.",
      "The operator requests visual inspection of RGB-D content rather than a file-presence check."
    ],
    "when_not_to_use": [
      "No synchronized RGB-D bundle or registered-depth product is available.",
      "A historical validation is being treated as proof for a new camera boot or calibration revision.",
      "The request requires physical motion."
    ],
    "side_effects": [
      "Reads one synchronized shared-memory RGB-D bundle.",
      "Writes local RGB, registered-depth, and composite diagnostic images.",
      "Calls one configured VLM route with bounded fallback.",
      "Does not move hardware or publish a motion-usable transform."
    ],
    "safety_class": "READ_ONLY",
    "expected_latency": "MEDIUM",
    "required_permissions": [
      "camera.read",
      "vlm.call"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "request": {
          "type": "string",
          "description": "Why the current RGB-D alignment must be validated."
        }
      },
      "required": [
        "request"
      ],
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "schema": {"const": "physical_agent.rgbd_alignment_validation"},
        "schema_version": {"const": 1},
        "request": {"type": "string"},
        "motion_usable": {"type": "boolean"},
        "numeric_quality": {"type": "object"},
        "vlm_review": {"type": "object"},
        "vlm_route": {"type": "object"},
        "geometry": {"type": "object"},
        "timing": {"type": "object"},
        "data_route": {"type": "object"},
        "capability_binding": {"type": "object"},
        "artifacts": {
          "type": "object",
          "properties": {
            "rgb": {"type": "string"},
            "registered_depth": {"type": "string"},
            "composite": {"type": "string"}
          },
          "required": ["rgb", "registered_depth", "composite"],
          "additionalProperties": false
        },
        "image_review_required": {"type": "boolean"},
        "images_present_is_not_sufficient": {"type": "boolean"}
      },
      "required": [
        "schema", "schema_version", "request", "motion_usable",
        "numeric_quality", "vlm_review", "vlm_route", "geometry",
        "timing", "data_route", "capability_binding", "artifacts",
        "image_review_required", "images_present_is_not_sufficient"
      ],
      "additionalProperties": false,
      "x-midbrain-result-tiers": {
        "schema_version": 1,
        "compact_pointers": [
          "/schema", "/schema_version", "/request", "/motion_usable",
          "/numeric_quality", "/vlm_review", "/vlm_route", "/geometry",
          "/timing", "/artifacts", "/image_review_required",
          "/images_present_is_not_sufficient"
        ],
        "detail_policy": "HOST_SANITIZED_REFERENCE",
        "max_compact_bytes": 65536
      }
    },
    "execution_adapter": {
      "adapter_id": "test_agent.verify_rgbd_alignment.v1",
      "kind": "IN_PROCESS_BOUND_INSTANCE"
    }
  },
  "required_capabilities": [
    "camera.rgb",
    "camera.depth",
    "camera.depth_aligned_to_rgb",
    "camera.rgbd.bundle",
    "perception.vision_language"
