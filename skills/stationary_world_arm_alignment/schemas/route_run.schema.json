{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "midbrain.skill.stationary_world_arm_alignment.route_run",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "case_id",
    "route",
    "created_at_us",
    "observation",
    "observation_fingerprint",
    "outcome",
    "repeatability",
    "lifecycle",
    "operator_effort",
    "safety"
  ],
  "properties": {
    "schema": {
      "const": "midbrain.skill.stationary_world_arm_alignment.route_run"
    },
    "schema_version": {
      "const": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "route": {
      "enum": [
        "PROVIDER_COMPATIBILITY",
        "SKILL_LOCAL"
      ]
    },
    "created_at_us": {
      "type": "integer",
      "minimum": 1
    },
    "observation": {
      "type": "object"
    },
    "observation_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "outcome": {
      "type": "object"
    },
    "repeatability": {
      "type": "object"
    },
    "lifecycle": {
      "type": "object"
    },
    "operator_effort": {
      "type": "object"
    },
    "safety": {
      "type": "object",
      "required": [
        "physical_action_submitted",
        "controller_called",
        "control_mode_changed"
      ],
      "properties": {
        "physical_action_submitted": {
          "const": false
        },
        "controller_called": {
          "const": false
        },
        "control_mode_changed": {
          "const": false
        }
      }
    }
  },
  "additionalProperties": false
}
