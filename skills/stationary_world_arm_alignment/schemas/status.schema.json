{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "midbrain.skill.stationary_world_arm_alignment.status",
  "type": "object",
  "required": [
    "skill_id",
    "alignment_id",
    "mode",
    "state",
    "phase",
    "message",
    "updated_at_us"
  ],
  "properties": {
    "state": {
      "enum": [
        "PENDING",
        "RUNNING",
        "SUCCEEDED",
        "DEGRADED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "progress_kind": {
      "enum": [
        "milestone",
        "indeterminate"
      ]
    },
    "provider_responsive": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "provider_sessions": {
      "type": "array"
    }
  }
}
