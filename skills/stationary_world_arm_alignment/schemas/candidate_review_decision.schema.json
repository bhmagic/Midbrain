{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "midbrain.skill.stationary_world_arm_alignment.candidate_review_decision",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "decision_id",
    "alignment_id",
    "candidate_id",
    "candidate_sha256",
    "decision",
    "decision_state",
    "activation_state",
    "motion_usable",
    "decided_at_us",
    "candidate_expires_at_us",
    "reviewer",
    "idempotency_key",
    "intent_sha256",
    "expected_provenance",
    "rationale"
  ],
  "properties": {
    "schema": {
      "const": "midbrain.skill.stationary_world_arm_alignment.candidate_review_decision"
    },
    "schema_version": {
      "const": 1
    },
    "decision_id": {
      "type": "string",
      "format": "uuid"
    },
    "alignment_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "decision": {
      "enum": [
        "APPROVE",
        "REJECT"
      ]
    },
    "decision_state": {
      "enum": [
        "APPROVED_FOR_ACTIVATION",
        "REJECTED"
      ]
    },
    "activation_state": {
      "const": "NOT_ACTIVATED"
    },
    "motion_usable": {
      "const": false
    },
    "decided_at_us": {
      "type": "integer",
      "minimum": 1
    },
    "candidate_expires_at_us": {
      "type": "integer",
      "minimum": 1
    },
    "reviewer": {
      "type": "object",
      "required": [
        "issuer",
        "reviewer_id",
        "assurance",
        "assertion_nonce",
        "assertion_expires_at_us"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "intent_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "expected_provenance": {
      "type": "object"
    },
    "rationale": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
