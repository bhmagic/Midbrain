{
  "skill_type": "stationary_world_arm_alignment",
  "version": "0.8.9",
  "display_name": "Stationary World-Space Arm Finder",
  "ui": {
    "observation": {
      "kind": "MANAGER_HOSTED",
      "information_level": "RICH",
      "read_only": true
    },
    "developer": {
      "label": "Alignment Development and Review GUI",
      "url": "http://127.0.0.1:8011/",
      "launch_command": ".\\skills\\stationary_world_arm_alignment\\scripts\\run_gui.ps1",
      "stop_command": ".\\skills\\stationary_world_arm_alignment\\scripts\\stop_gui.ps1",
      "availability": "SEPARATE_LOCAL_PROCESS"
    }
  },
  "lifecycle": "FINITE",
  "agent_discovery": {
    "schema_version": 3,
    "discoverable": true,
    "tool_name": "calibrate_stationary_workcell",
    "description": "Run the retained FoundationPose stationary-workcell initializer when the operator explicitly mentions FoundationPose by name. Matching is case-insensitive and tolerates spacing, hyphenation, and minor spelling errors. This long-running initializer is not an automatic or default alignment fallback.",
    "when_to_use": [
      "The camera and robot base are stationary and a world-to-arm transform is missing or stale.",
      "A downstream spatial Skill requires a validated stationary workcell frame.",
      "The operator explicitly mentions FoundationPose by name, including a minor spelling variation."
    ],
    "when_not_to_use": [
      "The camera, workcell, or robot base is moving.",
      "The task only needs an existing valid transform.",
      "The user asks only to establish, inspect, or report the VIO world axes and explicitly excludes the arm base; inspect the current VIO world frame instead.",
      "The request is for continuous real-time body or mobile-base tracking.",
      "The operator asks generically to establish or calibrate both axes without naming FoundationPose."
    ],
    "side_effects": [
      "Acquires a Manager motion-inhibit lease.",
      "May start required perception providers.",
      "Publishes a new stationary world-to-arm transform and calibration result."
    ],
    "safety_class": "STATEFUL_NO_MOTION",
    "expected_latency": "HIGH",
    "required_permissions": [
      "camera.read",
      "robot.transforms.read",
      "world.transforms.publish",
      "motion.inhibit"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "request": {
          "type": "string",
          "description": "Complete operator request. It must mention FoundationPose by name; matching is case-insensitive and accepts spacing, hyphenation, and minor spelling errors."
        }
      },
      "required": [
        "request"
      ],
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "schema": {"type": "string"},
        "schema_version": {"type": "integer"},
        "status": {"type": "string"},
        "workflow_complete": {"type": "boolean"},
        "physical_motion_submitted": {"type": "boolean"},
        "alignment_id": {"type": "string"},
        "skill_id": {"type": "string"},
        "created_at_us": {"type": "integer"},
        "expires_at_us": {"type": "integer"},
        "mode": {"type": "string"},
        "world_frame": {"type": "string"},
        "vio_world_frame": {"type": "string"},
        "vio_session_epoch": {"type": "string"},
        "camera_frame": {"type": "string"},
        "camera_reference_timestamp_us": {"type": "integer"},
        "camera_reference_frame_number": {"type": "integer"},
        "camera_calibration_revision": {"type": "string"},
        "vio_from_camera_reference": {"type": "object"},
        "world_from_camera_reference": {"type": "object"},
        "world_from_vio": {"type": "object"},
        "world_from_base": {"type": "object"},
        "learned_tool_to_beak_translation_m": {"type": ["array", "null"], "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
        "mode_contract": {"type": "object"},
        "gripper_measurements": {"type": "array", "items": {"type": "object"}},
        "gripper_cross_source_comparison": {"type": "object"},
        "valid": {"type": "boolean"},
        "review_state": {"type": "string"},
        "candidate_review_mode": {"type": "string"},
        "candidate_sha256": {"type": "string"},
        "motion_usable": {"type": "boolean"},
        "candidate": {"type": ["object", "null"]},
        "diagnostics": {"type": "object"},
        "monitor_geometry": {"type": "object"},
        "required_next_tool": {"type": ["object", "null"]},
        "agent_instruction": {"type": "string"},
        "reason_code": {"type": "string"},
        "reason": {"type": "string"},
        "message": {"type": "string"},
        "required_name_mention": {"type": "string"},
        "canonical_example": {"type": "string"},
        "required_operator_action": {"type": "string"},
        "agent_request": {"type": "string"},
        "agent_adapter": {"type": "object"},
        "visual_evidence": {"type": ["object", "null"]}
      },
      "required": ["workflow_complete", "motion_usable", "agent_request", "agent_adapter"],
      "additionalProperties": true,
      "x-midbrain-result-tiers": {
        "schema_version": 1,
        "compact_pointers": [
          "/schema", "/schema_version", "/status", "/workflow_complete",
          "/physical_motion_submitted", "/alignment_id", "/skill_id",
          "/created_at_us", "/expires_at_us", "/mode", "/world_frame",
          "/vio_world_frame", "/vio_session_epoch", "/camera_frame",
          "/camera_calibration_revision", "/world_from_base",
          "/valid", "/review_state", "/candidate_review_mode",
          "/candidate_sha256", "/motion_usable", "/required_next_tool",
          "/agent_instruction", "/reason_code", "/reason", "/message",
          "/required_operator_action", "/agent_request", "/visual_evidence"
        ],
        "detail_policy": "HOST_SANITIZED_REFERENCE",
        "max_compact_bytes": 65536
      }
    },
    "execution_adapter": {
      "adapter_id": "skill.stationary_world_arm_alignment.cli.v1",
      "kind": "EXTERNAL_SKILL_ENTRYPOINT",
      "entrypoint": "scripts/run.ps1"
    }
  },
  "entrypoints": {
    "cli": "scripts/run.ps1",
    "gui": "scripts/run_gui.ps1",
    "stop_gui": "scripts/stop_gui.ps1",
    "check": "scripts/check.ps1"
  },
  "modes": [
    "auto",
    "foundation_base_vlm_gripper",
    "foundation_base_gripper",
    "vlm_gripper_only"
  ],
  "mode_contracts": {
    "foundation_base_vlm_gripper": {
      "base_alignment_source": "FOUNDATIONPOSE_BASE_POSE",
      "gripper_alignment_source": "VLM_GRIPPER_RGBD_BASE_X_RELATION",
      "foundation_pose_models": [
        "base"
      ],
      "requires_prior_alignment": false
    },
    "foundation_base_gripper": {
      "base_alignment_source": "FOUNDATIONPOSE_BASE_POSE",
      "gripper_alignment_source": "FOUNDATIONPOSE_GRIPPER_AUXILIARY_ONLY",
      "foundation_pose_models": [
        "base",
        "gripper"
      ],
      "requires_prior_alignment": false
    },
    "vlm_gripper_only": {
      "base_alignment_source": "PRIOR_ALIGNMENT_LOCKED_ROTATION",
      "gripper_alignment_source": "VLM_RGBD_BEAK",
      "foundation_pose_models": [],
      "requires_prior_alignment": true
    }
  },
  "result_schema_version": 3,
  "spatial_frame_contract": {
    "convention_id": "MIDBRAIN_X_FORWARD_Y_LEFT_Z_UP_V2",
    "camera_optical_convention_id": "CAMERA_OPTICAL_X_RIGHT_Y_DOWN_Z_FORWARD_V1",
    "base_orientation_hypothesis_resolution": "EXACTLY_ONE_OF_IDENTITY_RX180_RY180_RZ180_AT_CENTERED_CAD_MESH_ORIGIN_FROM_WORLD_UP_AND_GRIPPER_X_SIGN",
    "base_yaw_ambiguity_resolution": "INCLUDED_IN_SINGLE_MESH_CENTERED_BASE_ORIENTATION_HYPOTHESIS",
    "base_up_policy": "CANONICALIZE_Z_HEMISPHERE_AT_CENTERED_MESH_ORIGIN_THEN_WARN_ON_RESIDUAL_TILT",
    "projected_box_size_policy": "MAXIMUM_25_PERCENT_MISMATCH_TWO_ATTEMPTS",
    "legacy_y_up_candidates_accepted": false
  },
  "required_capabilities": [
    "camera.rgb",
    "camera.depth_aligned_to_rgb",
    "camera.rgbd_geometry",
    "localization.vio.local_pose",
    "robot_arm.transforms.local"
  ],
  "optional_capabilities": [
    "perception.object_pose",
    "robot_arm.joint_state"
  ],
  "required_subskills": [
    {
      "skill_type": "foundation_pose_object_localization",
      "required_for_modes": [
        "foundation_base_vlm_gripper",
        "foundation_base_gripper"
      ],
      "invocation": "IN_PROCESS_FINITE",
      "fallback": "PROVIDER_COMPATIBILITY_EXPLICIT_ONLY"
    }
  ],
  "published_streams": [
    "skills.stationary_world_arm_alignment.status",
    "skills.stationary_world_arm_alignment.result",
    "skills.stationary_world_arm_alignment.pose_overlay",
    "transform.stationary_world.vio",
    "transform.stationary_world.arm_base",
    "transform.stationary_world.vio.candidate",
    "transform.stationary_world.arm_base.candidate"
  ],
  "provider_residency": {
    "camera": "leave_running",
    "local_vio": "leave_running",
    "foundation_pose": "legacy_compatibility_route_only_stop_after_skill_when_no_foreign_sessions_exist"
  },
  "base_pose_engine": {
    "owner": "calibrate_stationary_workcell",
    "nested_skill": "foundation_pose_object_localization",
    "default_route": "NO_AUTOMATIC_BASE_POSE_ENGINE",
    "explicit_route": "FOUNDATIONPOSE_SKILL",
    "agent_activation_match": "FUZZY_EXPLICIT_FOUNDATIONPOSE_NAME_MENTION",
    "canonical_agent_request_example": "Use FoundationPose to establish the stationary world-to-arm-base transform.",
    "available_routes": [
      "FOUNDATIONPOSE_SKILL",
      "PROVIDER_COMPATIBILITY",
      "SKILL_LOCAL"
    ],
    "legacy_route_aliases": {
      "SKILL_LOCAL": "FOUNDATIONPOSE_SKILL"
    },
    "automatic_fallback_enabled": false,
    "skill_behavior": "finite_backend_lifetime_fresh_rgbd_samples_no_provider_session",
    "provider_route_status": "legacy_compatibility_fallback_pending_guarded_hardware_comparison"
  },
  "environment": {
    "type": "python_venv",
    "path": ".venv",
    "python": ">=3.11"
  }
}
