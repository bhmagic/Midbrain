{
  "skill_type": "locate_effector_front",
  "version": "0.2.1",
  "display_name": "Locate Effector Front",
  "lifecycle": "FINITE",
  "agent_discovery": {
    "schema_version": 2,
    "discoverable": true,
    "tool_name": "locate_effector_front",
    "description": "Locate the most distal visible point of the current robot effector, mounted tool, or held tool that still has reliable registered-depth evidence. Native camera geometry is returned only as explicit camera_system_x/y/z optical coordinates; transformed target points carry convention provenance. This is general alignment evidence, not a task-specific action point.",
    "when_to_use": [
      "A stationary alignment or registration task needs the general front reference of the visible effector assembly.",
      "A reflective or thin tool tip has missing depth and the most distal reliable point on the same rigid tool body is needed.",
      "A bare two-jaw gripper needs both front points registered before their 3D average is used."
    ],
    "when_not_to_use": [
      "The task needs a drill tip, hammer face, cutting edge, nozzle, or another task-specific action point.",
      "The effector or held tool is moving relative to the captured frame.",
      "The result would be treated as motion authorization or a published control frame."
    ],
    "side_effects": [
      "Reads one synchronized RGB and registered-depth frame plus timestamped transform evidence.",
      "Calls one configured VLM route with bounded backend fallback.",
      "Returns read-only point evidence and does not command or authorize motion."
    ],
    "safety_class": "READ_ONLY",
    "expected_latency": "MEDIUM",
    "required_permissions": [
      "camera.read",
      "world.transforms.read",
      "vlm.invoke"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "target_frame": {
          "type": "string",
          "description": "Calibrated target frame in which to return the registered front reference."
        }
      },
      "required": [
        "target_frame"
      ],
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "schema": {"const": "physical_agent.effector_front_reference"},
        "schema_version": {"const": 1},
        "status": {"type": "string"},
        "eligible_for_control_math": {"type": "boolean"},
        "motion_usable": {"type": "boolean"},
        "publishes_control_frame": {"type": "boolean"},
        "specialized_action_point": {"type": "boolean"},
        "observed_at_us": {"type": "integer"},
        "source_frame": {"type": "string"},
        "target_frame": {"type": "string"},
        "calibration_revision": {"type": ["string", "null"]},
        "effector_configuration": {"type": "string"},
        "front_geometry": {"type": "string"},
        "depth_fallback_reason": {"type": ["string", "null"]},
        "front_points": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "point_id": {"type": "string"},
              "registered_depth_pixel_yx": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer"}},
              "camera_system_point_m": {"type": "object"},
