        "vlm_route": {"type": "object"},
        "vlm_geometry": {"type": "object"},
        "vlm_evidence": {"type": "object"},
        "evidence_image": {"type": ["object", "null"]},
        "visual_evidence": {"type": ["object", "null"]},
        "input_temporal_evidence": {"type": "object"}
