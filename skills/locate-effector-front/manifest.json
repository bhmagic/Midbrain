            "target_point_m": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
            "pair_separation_m": {"type": ["number", "null"]}
          },
          "required": ["method", "target_point_m", "pair_separation_m"],
          "additionalProperties": false
        },
        "uncertainty_radius_m": {"type": "number"},
        "quality_reasons": {"type": "array", "items": {"type": "string"}},
        "quality_warnings": {"type": "array", "items": {"type": "string"}},
        "visual_measurement_usable": {"type": "boolean"},
