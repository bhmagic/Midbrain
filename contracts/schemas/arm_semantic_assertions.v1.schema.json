{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://midbrain.local/schemas/arm_semantic_assertions.v1.schema.json",
  "title": "Midbrain Arm Semantic Sphere Assertions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "frame_id",
    "policy",
    "map_identity",
    "coverage",
    "assertions"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "frame_id": {
      "type": "string",
      "minLength": 1
    },
    "policy": {
      "type": "object",
      "additionalProperties": true,
      "required": ["policy_id", "revision", "objects"],
      "properties": {
        "policy_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "objects": {"type": "array"}
      }
    },
    "map_identity": {"type": "string", "minLength": 1},
    "coverage": {
      "type": "object",
      "additionalProperties": true,
      "required": ["ready"],
      "properties": {
        "ready": {"type": "boolean"}
      }
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "assertion_id",
          "sphere_id",
          "object_id",
          "description",
          "center_m",
          "radius_m",
          "type",
          "semantic_source"
        ],
        "properties": {
          "assertion_id": {"type": "string", "minLength": 1},
          "sphere_id": {"type": "string", "minLength": 1},
          "object_id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "center_m": {
            "type": "array",
            "items": {"type": "number"},
            "minItems": 3,
            "maxItems": 3
          },
          "radius_m": {"type": "number", "exclusiveMinimum": 0},
          "type": {
            "enum": ["KEEP_OUT", "PUSHABLE", "WORK_OBJECT"]
          },
          "semantic_source": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
