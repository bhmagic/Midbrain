{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://midbrain.local/contracts/agent_event.v1.schema.json",
  "title": "Midbrain Agent Event v1",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "event_id",
    "sequence",
    "occurred_at",
    "run_id",
    "source",
    "type",
    "payload"
  ],
  "properties": {
    "schema": {
      "const": "midbrain.agent_event"
    },
    "schema_version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
      "maxLength": 160
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
