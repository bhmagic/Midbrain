{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://midbrain.local/schemas/arm_scene_segmentation_policy.v1.schema.json",
  "title": "Midbrain Arm Scene Segmentation Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "policy_id",
    "objects",
    "arm_description"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "const": "KEEP_OUT"
          }
        }
      },
      "minContains": 1,
      "items": {
        "$ref": "#/$defs/scene_object"
      }
    },
    "arm_description": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "scene_object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_id",
        "type",
        "description"
      ],
      "properties": {
        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "KEEP_OUT",
            "PUSHABLE",
            "WORK_OBJECT"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
