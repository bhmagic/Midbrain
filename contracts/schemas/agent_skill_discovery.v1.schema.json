{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://midbrain.local/schemas/agent_skill_discovery.v1.schema.json",
  "title": "Midbrain Agent Skill Discovery Descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "discoverable",
    "tool_name",
    "description",
    "when_to_use",
    "when_not_to_use",
    "side_effects",
    "safety_class",
    "expected_latency",
    "required_permissions",
    "input_schema",
    "execution_adapter"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "discoverable": {
      "type": "boolean"
    },
    "tool_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,63}$"
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "maxLength": 800
    },
    "when_to_use": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 4
      }
    },
    "when_not_to_use": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 4
      }
    },
    "side_effects": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "safety_class": {
      "enum": [
        "READ_ONLY",
        "STATEFUL_NO_MOTION",
        "PHYSICAL_MOTION_AUTHORIZATION_REQUIRED",
        "MANUAL_ONLY"
      ]
    },
    "expected_latency": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "UNKNOWN"
      ]
    },
    "required_permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "input_schema": {
      "type": "object",
      "required": [
        "type",
        "properties",
        "required",
        "additionalProperties"
      ],
      "properties": {
        "type": {
          "const": "object"
        },
        "properties": {
          "type": "object"
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "additionalProperties": {
          "const": false
        }
      }
    },
    "execution_adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_id",
        "kind"
      ],
      "properties": {
        "adapter_id": {
          "type": "string",
          "minLength": 3
        },
        "kind": {
          "enum": [
            "IN_PROCESS_BOUND_INSTANCE",
            "EXTERNAL_SKILL_ENTRYPOINT",
            "MANUAL_LOCAL_ONLY"
          ]
        },
        "entrypoint": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "disabled_reason": {
      "type": "string",
      "minLength": 8
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "discoverable": {
            "const": false
          }
        }
      },
      "then": {
        "required": [
          "disabled_reason"
        ]
      }
    }
  ]
}
