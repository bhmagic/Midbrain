{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://midbrain.local/schemas/mounted_effector_profile.v1.schema.json",
  "title": "Midbrain Mounted Effector Profile v1",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "profile_id",
    "profile_revision",
    "display_name",
    "assembly_type",
    "qualification",
    "robot_compatibility",
    "kinematic_attachment",
    "controlled_frame",
    "acting_frames",
    "collision_primitives",
    "inertial",
    "inactive_joint_names",
    "actuator_groups",
    "invalidation_conditions"
  ],
  "properties": {
    "schema": {"const": "midbrain.mounted_effector_profile"},
    "schema_version": {"const": 1},
    "profile_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "profile_revision": {"type": "string", "minLength": 1, "maxLength": 200},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 240},
    "assembly_type": {
      "enum": ["FIXED_EFFECTOR", "REPLACEABLE_EFFECTOR", "MOUNTED_TOOL"]
    },
    "qualification": {
      "enum": ["DEVELOPMENT", "SOFTWARE_TESTED", "PHYSICALLY_QUALIFIED"]
    },
    "robot_compatibility": {
      "type": "object",
      "required": ["model_id", "model_revision", "terminal_frame"],
      "properties": {
        "model_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "model_revision": {"type": "string", "minLength": 1, "maxLength": 200},
        "terminal_frame": {"type": "string", "minLength": 1, "maxLength": 200}
      },
      "additionalProperties": false
    },
    "kinematic_attachment": {
      "type": "object",
      "required": ["parent_frame", "child_frame", "transform", "qualification"],
      "properties": {
        "parent_frame": {"type": "string", "minLength": 1, "maxLength": 200},
        "child_frame": {"type": "string", "minLength": 1, "maxLength": 200},
        "transform": {"$ref": "#/$defs/transform"},
        "qualification": {"type": "string", "minLength": 1, "maxLength": 240},
        "source_reference": {"type": "string", "minLength": 1, "maxLength": 500}
      },
      "additionalProperties": false
    },
    "controlled_frame": {
      "type": "object",
      "required": ["frame_id", "parent_frame", "transform", "semantic_role"],
      "properties": {
        "frame_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "parent_frame": {"type": "string", "minLength": 1, "maxLength": 200},
        "transform": {"$ref": "#/$defs/transform"},
        "semantic_role": {"const": "FREE_SPACE_CONTROLLED_FRAME"}
      },
      "additionalProperties": false
    },
    "acting_frames": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/actingFrame"}
    },
    "collision_primitives": {
      "type": "array",
      "items": {"$ref": "#/$defs/framePrimitive"},
      "description": "Collision geometry owned by this mounted effector and expressed in its named assembly frames. Replacing the effector replaces these primitives with it."
    },
    "inertial": {
      "type": "object",
      "required": ["reference_frame", "mass_kg", "center_of_mass_m", "inertia_kg_m2", "qualification"],
      "properties": {
        "reference_frame": {"type": "string", "minLength": 1, "maxLength": 200},
        "mass_kg": {"type": "number", "minimum": 0},
        "center_of_mass_m": {"$ref": "#/$defs/vector3"},
        "inertia_kg_m2": {
          "type": "object",
          "required": ["ixx", "ixy", "ixz", "iyy", "iyz", "izz"],
          "properties": {
            "ixx": {"type": "number", "minimum": 0},
            "ixy": {"type": "number"},
            "ixz": {"type": "number"},
            "iyy": {"type": "number", "minimum": 0},
            "iyz": {"type": "number"},
            "izz": {"type": "number", "minimum": 0}
          },
          "additionalProperties": false
        },
        "qualification": {"type": "string", "minLength": 1, "maxLength": 240}
      },
      "additionalProperties": false
    },
    "actuator_groups": {
      "type": "array",
      "items": {"$ref": "#/$defs/actuatorGroup"}
    },
    "inactive_joint_names": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 200},
      "uniqueItems": true,
      "description": "Model joints physically unavailable under this mounted effector. They are excluded from both the arm command group and active effector actuator groups."
    },
    "invalidation_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1, "maxLength": 500},
      "uniqueItems": true
    },
    "extensions": {
      "type": "object",
      "description": "Namespaced optional consumer configuration. Core mounted-effector consumers preserve unknown extension objects and do not acquire their responsibilities. A consumer validates the extension namespace it owns before use.",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_.-]{2,199}$"
      },
      "properties": {
        "midbrain.skill.slicing_blade_profiles.v1": {
          "$ref": "#/$defs/slicingBladeProfiles"
        },
        "midbrain.skill.refine_arm_root_translation.v1": {
          "$ref": "#/$defs/armRootTranslationVisualAlignment"
        }
      },
      "additionalProperties": {"type": "object"}
    }
  },
  "$defs": {
    "slicingBladeProfiles": {
      "type": "object",
      "required": [
        "schema",
        "schema_version",
        "default_profile_number",
        "profiles"
      ],
      "properties": {
        "schema": {"const": "midbrain.effector_slicing_blade_profiles"},
        "schema_version": {"const": 1},
        "default_profile_number": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "profile_number",
              "name",
              "blade_direction_effector",
              "slicing_direction_effector"
            ],
            "properties": {
              "profile_number": {"type": "integer", "minimum": 1},
              "name": {"type": "string", "minLength": 1, "maxLength": 120},
              "blade_direction_effector": {"$ref": "#/$defs/vector3"},
              "slicing_direction_effector": {"$ref": "#/$defs/vector3"},
              "locked_joint_names": {
                "type": "array",
                "maxItems": 6,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1, "maxLength": 120}
              }
            },
            "additionalProperties": false
          }
        },
        "qualification": {"type": "string", "minLength": 1, "maxLength": 200},
        "note": {"type": "string", "minLength": 1, "maxLength": 1000}
      },
      "additionalProperties": false
    },
    "vector3": {
      "type": "array",
      "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}],
      "items": false
    },
    "positiveVector3": {
      "type": "array",
      "prefixItems": [
        {"type": "number", "exclusiveMinimum": 0},
        {"type": "number", "exclusiveMinimum": 0},
        {"type": "number", "exclusiveMinimum": 0}
      ],
      "items": false
    },
    "transform": {
      "type": "object",
      "required": ["translation_m", "rpy_rad"],
      "properties": {
        "translation_m": {"$ref": "#/$defs/vector3"},
        "rpy_rad": {"$ref": "#/$defs/vector3"}
      },
      "additionalProperties": false
    },
    "actingFrame": {
      "type": "object",
      "required": ["frame_id", "parent_frame", "transform", "semantic_roles"],
      "properties": {
        "frame_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "parent_frame": {"type": "string", "minLength": 1, "maxLength": 200},
        "transform": {"$ref": "#/$defs/transform"},
        "semantic_roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["GRIP_CENTER", "TOOL_CENTER_POINT", "CONTACT_POINT", "CUTTING_EDGE", "VISUAL_LANDMARK"]
          },
          "uniqueItems": true
        },
        "qualification": {"type": "string", "minLength": 1, "maxLength": 240}
      },
      "additionalProperties": false
    },
    "framePrimitive": {
      "type": "object",
      "required": ["primitive_id", "frame_id", "transform", "shape", "qualification"],
      "properties": {
        "primitive_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "frame_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "transform": {"$ref": "#/$defs/transform"},
        "shape": {
          "oneOf": [
            {
              "type": "object",
              "required": ["type", "radius_m"],
              "properties": {
                "type": {"const": "SPHERE"},
                "radius_m": {"type": "number", "exclusiveMinimum": 0}
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["type", "radius_m", "length_m", "axis"],
              "properties": {
                "type": {"const": "CAPSULE"},
                "radius_m": {"type": "number", "exclusiveMinimum": 0},
                "length_m": {"type": "number", "minimum": 0},
                "axis": {"enum": ["X", "Y", "Z"]}
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["type", "size_m"],
              "properties": {
                "type": {"const": "BOX"},
                "size_m": {"$ref": "#/$defs/positiveVector3"}
              },
              "additionalProperties": false
            }
          ]
        },
        "qualification": {"type": "string", "minLength": 1, "maxLength": 240}
      },
      "additionalProperties": false
    },
    "actuatorGroup": {
      "type": "object",
      "required": ["group_id", "resource_id", "joint_names", "capabilities"],
      "properties": {
        "group_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "resource_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "joint_names": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1, "maxLength": 200},
          "uniqueItems": true
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1, "maxLength": 240},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "armRootTranslationVisualAlignment": {
      "type": "object",
      "required": [
        "schema",
        "schema_version",
        "qualification_state",
        "arm_base_frame",
        "capture_motion_policy",
        "refinement_policy",
        "default_visual_alignment_landmark",
        "landmark_fallback_policy",
        "visual_alignment_landmarks",
        "reference_image_policy"
      ],
      "properties": {
        "schema": {"const": "midbrain.effector_visual_alignment"},
        "schema_version": {"const": 1},
        "qualification_state": {
          "enum": ["DEVELOPMENT", "QUALIFIED", "REVOKED"]
        },
        "arm_base_frame": {"type": "string", "minLength": 1, "maxLength": 200},
        "capture_motion_policy": {
          "$ref": "#/$defs/alignmentCaptureMotionPolicy"
        },
        "refinement_policy": {
          "$ref": "#/$defs/alignmentRefinementPolicy"
        },
        "default_visual_alignment_landmark": {
          "type": "string",
          "pattern": "^[a-z0-9_]{3,100}$"
        },
        "landmark_fallback_policy": {
          "$ref": "#/$defs/alignmentLandmarkFallbackPolicy"
        },
        "visual_alignment_landmarks": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/alignmentLandmark"}
        },
        "reference_image_policy": {
          "type": "object",
          "required": ["implementation_status", "maximum_images_per_call", "note"],
          "properties": {
            "implementation_status": {"enum": ["FUTURE", "AVAILABLE"]},
            "maximum_images_per_call": {"type": "integer", "minimum": 0, "maximum": 3},
            "note": {"type": "string", "minLength": 20, "maxLength": 1000}
          },
          "additionalProperties": false
        },
        "invalidation_conditions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 500},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "alignmentCaptureMotionPolicy": {
      "type": "object",
      "required": [
        "maximum_landmark_motion_m",
        "additional_camera_timing_margin_us",
        "arm_transform_timestamp_semantics",
        "arm_feedback_age_field_path",
        "fallback_arm_feedback_age_ms",
        "maximum_arm_feedback_age_ms",
        "preferred_arm_feedback_observation_age_ms",
        "maximum_transform_wait_ms",
        "transform_retry_interval_ms",
        "temporal_sample_count",
        "qualification",
        "policy_note"
      ],
      "properties": {
        "maximum_landmark_motion_m": {"type": "number", "minimum": 0.0},
        "additional_camera_timing_margin_us": {"type": "integer", "minimum": 0},
        "arm_transform_timestamp_semantics": {
          "enum": [
            "SNAPSHOT_TIME_WITH_FEEDBACK_AGE",
            "MEASURED_JOINT_BATCH_ACQUISITION_ESTIMATE"
          ]
        },
        "arm_feedback_age_field_path": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "fallback_arm_feedback_age_ms": {"type": "number", "minimum": 0.0},
        "maximum_arm_feedback_age_ms": {"type": "number", "minimum": 0.0},
        "preferred_arm_feedback_observation_age_ms": {"type": "number", "exclusiveMinimum": 0.0},
        "maximum_transform_wait_ms": {"type": "number", "exclusiveMinimum": 0.0},
        "transform_retry_interval_ms": {"type": "number", "exclusiveMinimum": 0.0},
        "temporal_sample_count": {"type": "integer", "minimum": 3, "maximum": 21},
        "qualification": {"type": "string", "minLength": 3},
        "policy_note": {"type": "string", "minLength": 20}
      },
      "additionalProperties": false
    },
    "alignmentRefinementPolicy": {
      "type": "object",
      "required": [
        "second_vlm_review_raw_delta_threshold_m",
        "maximum_raw_translation_delta_m",
        "maximum_adopted_translation_delta_m",
        "minimum_landmark_confidence",
        "minimum_same_surface_confidence"
      ],
      "properties": {
        "second_vlm_review_raw_delta_threshold_m": {"type": "number", "minimum": 0.0},
        "maximum_raw_translation_delta_m": {"type": "number", "exclusiveMinimum": 0.0},
        "maximum_adopted_translation_delta_m": {"type": "number", "exclusiveMinimum": 0.0},
        "minimum_landmark_confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "minimum_same_surface_confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0}
      },
      "additionalProperties": false
    },
    "alignmentLandmarkFallbackPolicy": {
      "type": "object",
      "required": [
        "selection_order",
        "automatic_substitution_allowed",
        "no_hardware_modification_strategy",
        "optional_physical_fiducial_policy"
      ],
      "properties": {
        "selection_order": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9_]{3,100}$"}
        },
        "automatic_substitution_allowed": {"const": false},
        "no_hardware_modification_strategy": {"type": "string", "minLength": 20},
        "optional_physical_fiducial_policy": {"type": "string", "minLength": 20}
      },
      "additionalProperties": false
    },
    "alignmentLandmark": {
      "type": "object",
      "required": [
        "landmark_id",
        "display_name",
        "geometry",
        "required_point_ids",
        "aggregation_policy",
        "description_for_vlm",
        "tool_point_binding",
        "visibility"
      ],
      "properties": {
        "landmark_id": {"type": "string", "pattern": "^[a-z0-9_]{3,100}$"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 200},
        "geometry": {
          "enum": ["SINGLE_REGISTERED_3D_POINT", "MEAN_OF_REGISTERED_3D_POINTS"]
        },
        "required_point_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9_]{3,100}$"}
        },
        "aggregation_policy": {
          "type": "object",
          "required": ["method", "requires_all_points", "missing_point_policy"],
          "properties": {
            "method": {"const": "ARITHMETIC_MEAN_OF_ALL_REGISTERED_3D_POINTS"},
            "requires_all_points": {"const": true},
            "missing_point_policy": {"const": "REJECT_OBSERVATION"}
          },
          "additionalProperties": false
        },
        "description_for_vlm": {"type": "string", "minLength": 20},
        "tool_point_binding": {
          "$ref": "#/$defs/alignmentToolPointBinding"
        },
        "pair_separation_m": {
          "type": "object",
          "properties": {
            "minimum": {"type": ["number", "null"], "minimum": 0.0},
            "maximum": {"type": ["number", "null"], "minimum": 0.0},
            "nominal": {"type": ["number", "null"], "minimum": 0.0},
            "qualification": {"type": "string", "minLength": 3}
          },
          "additionalProperties": false
        },
        "visibility": {"type": "object"},
        "cad_asset_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "vlm_reference_asset_ids": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "relationship_to_controlled_frame": {"type": "string"}
      },
      "additionalProperties": false
    },
    "alignmentToolPointBinding": {
      "type": "object",
      "required": [
        "source",
        "runtime_key",
        "controlled_frame_to_landmark_translation_m",
        "landmark_to_controlled_frame_translation_m",
        "qualification"
      ],
      "properties": {
        "source": {"type": "string", "minLength": 3},
        "runtime_key": {"type": ["string", "null"]},
        "controlled_frame_to_landmark_translation_m": {"$ref": "#/$defs/vector3"},
        "landmark_to_controlled_frame_translation_m": {"$ref": "#/$defs/vector3"},
        "qualification": {"type": "string", "minLength": 3},
        "measurement_note": {"type": "string", "minLength": 20}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
